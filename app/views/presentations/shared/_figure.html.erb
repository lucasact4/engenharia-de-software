<%#
  Figura ampliável. Com JavaScript, o botão abre o lightbox; sem JavaScript, aparece o link
  "Abrir imagem" (oculto na impressão, para o PDF não levar links para o servidor local).
  locals: image, alt, caption, zoom_image (opcional), state (opcional), tag_text (opcional), modifier (opcional)
          variants (opcional): versões por tema, de Presentation#capture_variants. Cada versão fica
          no HTML e o CSS mostra a do tema ativo, na miniatura e na ampliação.
%>
<% variants = local_assigns[:variants].presence ||
     [ { theme: "any", image: image, zoom: local_assigns[:zoom_image].presence || image, alt: alt } ] %>
<figure class="apr-figure <%= local_assigns[:modifier] %>">
  <button type="button"
          class="apr-figure__zoom"
          data-action="presentation#zoom"
          data-zoom-src="<%= image_path(variants.first[:zoom]) %>"
          aria-label="Ampliar imagem: <%= caption %>">
    <% variants.each do |variant| %>
      <%= image_tag variant[:image], alt: variant[:alt],
            class: [ "apr-figure__img", ("apr-theme-only--#{variant[:theme]}" unless variant[:theme] == "any") ],
            decoding: "async", data: { zoom_src: image_path(variant[:zoom]), theme: variant[:theme] } %>
    <% end %>
    <span class="apr-figure__hint" aria-hidden="true"><%= render "presentations/shared/icon", name: "zoom" %> Ampliar</span>
  </button>
  <figcaption class="apr-figure__caption">
    <span class="apr-figure__title"><%= caption %></span>
    <% if local_assigns[:state].present? %><%= presentation_state(state) %><% end %>
    <% if local_assigns[:tag_text].present? %><span class="apr-tag apr-tag--warn"><%= tag_text %></span><% end %>
    <% variants.each do |variant| %>
      <a class="apr-figure__open apr-more <%= "apr-theme-only--#{variant[:theme]}" unless variant[:theme] == "any" %>" href="<%= image_path(variant[:zoom]) %>">Abrir imagem</a>
    <% end %>
  </figcaption>
</figure>
