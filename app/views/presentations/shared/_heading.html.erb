<%# Cabeçalho padrão de slide. locals: slide, kicker, title, lead (opcional) %>
<header class="apr-head">
  <p class="apr-kicker">
    <span class="apr-kicker__num"><%= slide.appendix ? "Apêndice #{slide.label}" : slide.label %></span>
    <span class="apr-kicker__text"><%= kicker %></span>
  </p>
  <h2 id="<%= slide.heading_id %>" class="apr-title"><%= title %></h2>
  <% if local_assigns[:lead].present? %>
    <p class="apr-lead"><%= lead %></p>
  <% end %>
</header>
