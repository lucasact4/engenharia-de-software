<%= render "presentations/shared/heading", slide: slide,
      kicker: "ensaio",
      title: "Roteiro e tempo" %>
<p class="apr-lead apr-estimate <%= 'is-over' if @selection.over_limit? %>" data-presentation-target="estimate"><%= presentation_estimate_text(@selection) %></p>
<p class="apr-source">Soma dos tempos definidos no roteiro para os slides principais selecionados. É uma estimativa: o ensaio cronometrado continua necessário.</p>

<div class="apr-table-wrap">
  <table class="apr-table apr-table--compact">
    <caption class="apr-sr-only">Tempo estimado e responsável por slide selecionado</caption>
    <thead>
      <tr>
        <th scope="col">Slide</th>
        <th scope="col">Título</th>
        <th scope="col">Tempo</th>
        <th scope="col">Acumulado</th>
        <th scope="col">Quem apresenta</th>
      </tr>
    </thead>
    <tbody>
      <% elapsed = 0 %>
      <% presentation.main_slides.each do |item| %>
        <% visible = @selection.slide_visible?(item) %>
        <% elapsed += item.seconds if visible %>
        <%= presentation_slide_ref item.id, :tr do %>
          <td><%= presentation_slide_label item %></td>
          <th scope="row"><%= item.title %></th>
          <td><%= presentation_duration(item.seconds) %></td>
          <td data-apr-elapsed-for="<%= item.id %>"><%= presentation_duration(elapsed) if visible %></td>
          <td><%= item.presenter || "A definir" %></td>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
<%= presentation_update_note("roteiro.yml", "tempo e responsavel de cada slide.") %>
