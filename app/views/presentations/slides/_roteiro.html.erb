<%= render "presentations/shared/heading", slide: slide,
      kicker: "ensaio",
      title: "Ordem dos slides e responsáveis" %>
<div class="apr-table-wrap">
  <table class="apr-table apr-table--compact">
    <caption class="apr-sr-only">Responsável por slide selecionado</caption>
    <thead>
      <tr>
        <th scope="col">Slide</th>
        <th scope="col">Título</th>
        <th scope="col">Quem apresenta</th>
      </tr>
    </thead>
    <tbody>
      <% presentation.main_slides(@selection.delivery).each do |item| %>
        <%= presentation_slide_ref item.id, :tr do %>
          <td><%= presentation_slide_label item %></td>
          <th scope="row"><%= @selection.slide_title(item) %></th>
          <td><%= item.presenter || "A definir" %></td>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
<%= presentation_update_note("roteiro.yml", "responsável por cada slide.") %>
