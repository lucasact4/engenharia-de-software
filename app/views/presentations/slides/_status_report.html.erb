<% retro = presentation.retrospective %>
<%= render "presentations/shared/heading", slide: slide,
      kicker: "status report · aprendizados",
      title: "Quatro aprendizados para a próxima etapa" %>

<div class="apr-lessons apr-lessons--organized apr-fit">
  <%= presentation_item slide, "aprendizados", :section, class: "apr-lessons__main", aria: { label: "O que aprendemos" } do %>
    <% if retro.lessons.any? %>
      <ol class="apr-lessons__list" role="list">
        <% retro.lessons.each_with_index do |lesson, index| %>
          <li class="apr-lesson">
            <span class="apr-lesson__num" aria-hidden="true"><%= index + 1 %></span>
            <div>
              <% if lesson.title %><h3 class="apr-lesson__title"><%= lesson.title %></h3><% end %>
              <p class="apr-lesson__text"><%= lesson.text %></p>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="apr-inline-pending"><%= presentation_state(:aguardando_evidencia) %> Pendente: registrar as lições da retrospectiva em <code>retrospectiva.yml</code>.</p>
    <% end %>
  <% end %>

  <%= presentation_group slide, %w[registro], class: "apr-lessons__side" do %>
    <%= presentation_item slide, "registro", :aside, class: "apr-lessons__ref", aria: { label: "Cartões de aprendizados" } do %>
      <% if retro.lessons_image.present? %>
        <%= render "presentations/shared/figure",
              image: retro.lessons_image, alt: retro.lessons_image_alt,
              caption: "Aprendi", modifier: "apr-figure--lessons" %>
      <% end %>
      <p class="apr-lessons__links">
        <% if retro.link %>
          <%= link_to retro.link, class: "apr-more", target: "_blank", rel: "noopener noreferrer" do %>Abrir retrospectiva<span class="apr-sr-only"> (abre em nova aba)</span><% end %>
        <% end %>
        <%= presentation_slide_ref "retrospectiva" do %><a class="apr-more" href="#s-retrospectiva">Slide do quadro</a><% end %>
      </p>
      <% unless retro.lessons_image.present? %>
        <p class="apr-inline-pending"><%= presentation_state(:aguardando_evidencia) %> Pendente: anexar a imagem real da dinâmica.</p>
      <% end %>
    <% end %>
  <% end %>
</div>
<%= presentation_update_note("retrospectiva.yml", "coluna Aprendi, sua captura e link da retrospectiva.") %>
