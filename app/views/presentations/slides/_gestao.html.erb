<% g = presentation.gestao %>
<% links = presentation.entrega[:links] %>
<%= render "presentations/shared/heading", slide: slide,
      kicker: "monitoramento",
      title: "Cards no Trello com requisitos e links para os ambientes" %>

<div class="apr-mgmt apr-mgmt--two apr-fit">
  <%= presentation_item slide, "cards", :section, class: "apr-mgmt__col", aria: { labelledby: "#{slide.dom_id}-cards" } do %>
    <h3 id="<%= slide.dom_id %>-cards" class="apr-mgmt__title">
      <%= render "presentations/shared/icon", name: "board" %> Cards e requisitos
    </h3>
    <ul class="apr-cards" role="list">
      <% g[:cards].each do |card| %>
        <li class="apr-cards__item">
          <span class="apr-cards__num">#<%= card[:numero] %></span>
          <%= presentation_link(card[:titulo], card[:url], class: "apr-cards__title") %>
          <%= presentation_state(card[:estado], short: true) %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= presentation_group slide, %w[ambientes trello], :section, class: "apr-mgmt__col", aria: { labelledby: "#{slide.dom_id}-ambientes" } do %>
    <h3 id="<%= slide.dom_id %>-ambientes" class="apr-mgmt__title">
      <%= render "presentations/shared/icon", name: "external" %> Quadro e ambientes
    </h3>
    <%= presentation_item slide, "ambientes", class: "apr-envs" do %>
      <p class="apr-label">Links para ambientes</p>
      <ul class="apr-envs__list" role="list">
        <% g[:ambientes].each do |ambiente| %>
          <li>
            <%= presentation_link(ambiente[:nome], ambiente[:url], class: "apr-envs__name") %>
            <%= presentation_state(ambiente[:estado], short: true) %>
            <% if ambiente[:nota].present? %><span class="apr-envs__note"><%= ambiente[:nota] %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= presentation_item slide, "trello", :p do %>
      <%= presentation_link("Abrir o quadro do SGU", links[:trello], class: "apr-btn apr-btn--outline") %>
    <% end %>
  <% end %>
</div>
<%= presentation_update_note("gestao.yml", "cards e ambientes.") %>
