<% ev = presentation.evolucao %>
<%= render "presentations/shared/heading", slide: slide, kicker: "evolução do projeto", title: "Da primeira landing à segunda entrega" %>
<%= presentation_item slide, "linha-do-tempo", class: "apr-history", aria: { label: "Linha do tempo do projeto" } do %>
  <% ev[:marcos].each_slice(6).with_index do |marcos, row| %>
    <section class="apr-history__band" aria-label="Etapa <%= row + 1 %>">
      <p class="apr-history__stage"><%= row.zero? ? "Base, primeira entrega e modelagem" : "Produto, equipe e segunda entrega" %> <span aria-hidden="true">→</span></p>
      <ol class="apr-history__row" start="<%= row * 6 + 1 %>">
        <% marcos.each do |marco| %>
          <li class="apr-history__item">
            <span class="apr-history__dot" aria-hidden="true"></span>
            <p class="apr-history__date"><time datetime="<%= marco[:data] %>" title="<%= marco[:nota_data] if marco[:estimada] %>"><%= "≈ " if marco[:estimada] %><%= presentation_date(marco[:data]) %></time><% if marco[:estimada] %><span class="apr-sr-only"> (data estimada)</span><% end %></p>
            <h3 class="apr-history__title"><%= marco[:titulo] %></h3>
            <p class="apr-history__text"><%= marco[:texto] %></p>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>
<% end %>
<%= presentation_item slide, "capacidades", :p, class: "apr-source" do %>Registro, atendimento e mural já funcionam; cadastro e catálogo seguem em evolução.<% end %>
<%= presentation_item slide, "observacoes", :p, class: "apr-source" do %><%= ev[:observacoes].join(" ") %><% end %>
