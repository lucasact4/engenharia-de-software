<% item = presentation.diagramas[:itens].find { |diagrama| diagrama[:id] == "modelo-conceitual" } %>
<%= render "presentations/shared/heading", slide: slide,
      kicker: "modelagem",
      title: "Conceitos do domínio e suas multiplicidades" %>

<%= presentation_item slide, "diagrama", class: "apr-model-diagram" do %>
  <%= render "presentations/shared/er_diagram", key: "conceptual" %>
<% end %>

<%= presentation_group slide, %w[situacao distincao], class: "apr-model-foot apr-model-foot--compact" do %>
  <%= presentation_item slide, "situacao", :ul, class: "apr-model-badges", role: "list", aria: { label: "Situação do diagrama" } do %>
    <% [ [ "producao", "Diagrama produzido", item[:producao] ], [ "premissas", "Regras do modelo", item[:premissas] ] ].each do |key, rotulo, info| %>
      <% next if info.blank? %>
      <% note = [ info[:nota], presentation_date(info[:data]), Array(info[:responsaveis]).to_sentence.presence ].compact_blank.join(" · ") %>
      <li class="apr-model-badge">
        <span class="apr-model-badge__label"><%= rotulo %></span>
        <%= presentation_state(info[:estado], short: true) %>
        <% if note.present? %>
          <%= render "presentations/shared/info", id: "#{slide.dom_id}-#{key}", label: "Detalhes: #{rotulo}", title: rotulo, text: note, print_text: note %>
        <% end %>
      </li>
    <% end %>
  <% end %>

  <%= presentation_item slide, "distincao", :p, class: "apr-model-distinction" do %>
    <span>DER nos apêndices</span>
    <%= presentation_slide_ref "modelo-dados" do %><a class="apr-btn apr-btn--ghost" href="#s-modelo-dados">Ver DER <%= render "presentations/shared/icon", name: "arrow" %></a><% end %>
    <%= render "presentations/shared/info", id: "#{slide.dom_id}-der", label: "O que é DER e o que há nos apêndices", title: "Diagrama Entidade-Relacionamento",
          text: "O DER mostra tabelas, campos, chaves e relações do banco. Os apêndices detalham o núcleo, os dados operacionais, as interações sociais e a infraestrutura." %>
  <% end %>
<% end %>
<%= presentation_update_note("diagramas.yml", "producao e premissas; estrutura do modelo em data_diagrams.yml.") %>
