<% r = presentation.requisitos %>
<%= render "presentations/shared/heading", slide: slide, kicker: "problema e proposta", title: "Quem observa precisa alcançar quem resolve" %>

<div class="apr-pv">
  <div class="apr-pv__text">
    <%= presentation_item slide, "dores", class: "apr-pv__block" do %>
      <p class="apr-pv__statement"><%= r.dig(:problema, :frase_curta).presence || r.dig(:problema, :frase) %></p>
      <p class="apr-pv__label">Hoje na Rural</p>
      <ul class="apr-pv__pains" role="list">
        <% r.dig(:problema, :dores).each do |dor| %>
          <li title="<%= dor[:texto] %>"><span class="apr-pv__x" aria-hidden="true">✕</span><%= dor[:curto].presence || dor[:titulo] %></li>
        <% end %>
      </ul>
    <% end %>

    <%= presentation_item slide, "proposta", class: "apr-pv__block" do %>
      <p class="apr-pv__label">Com o SGU</p>
      <ol class="apr-pv__flow" role="list">
        <% r[:fluxo_valor].each_with_index do |passo, index| %>
          <li title="<%= passo[:texto] %>">
            <span class="apr-pv__num" aria-hidden="true"><%= index + 1 %></span>
            <span><strong><%= passo[:titulo] %></strong> <%= passo[:curto].presence || passo[:texto] %></span>
          </li>
        <% end %>
      </ol>
    <% end %>

    <%= presentation_item slide, "publico", :p, class: "apr-pv__audience" do %>
      <span class="apr-pv__label">Para</span>
      <% r[:publico].each do |publico| %><span class="apr-chip"><%= publico %></span><% end %>
    <% end %>
  </div>

  <figure class="apr-pv__art">
    <%= render "presentations/shared/campus_illustration" %>
    <figcaption class="apr-source">Ilustração do SGU no campus Dois Irmãos da UFRPE.</figcaption>
  </figure>
</div>

<%= presentation_update_note("requisitos.yml", "frase_curta, dores (curto), público e fluxo de valor (curto).") %>
