<% plan = presentation.planejamento %>
<%= render "presentations/shared/heading", slide: slide,
      kicker: "até a próxima entrega", title: "O mural já funciona. O próximo passo é facilitar a participação." %>

<div class="apr-next apr-next--showcase">
  <%= presentation_item slide, "marco", :section, class: "apr-next__showcase apr-milestone-card", aria: { label: "Marco demonstrável" } do %>
    <p class="apr-milestone-card__eyebrow"><%= render "presentations/shared/icon", name: "check" %> Já funciona</p>
    <p class="apr-label">Marco demonstrável</p>
    <h3 class="apr-milestone__title"><%= plan.dig(:marco, :titulo) %></h3>
    <p class="apr-milestone__text"><%= plan.dig(:marco, :descricao) %></p>
    <% capture = plan.dig(:marco, :captura) %>
    <% if capture.present? %>
      <%= render "presentations/shared/figure", image: capture[:imagem], alt: capture[:alt], variants: presentation.capture_variants(capture), caption: "Post no mural do campus", modifier: "apr-figure--social-post" %>
    <% end %>
  <% end %>
  <%= presentation_item slide, "passos", :ol, class: "apr-steps apr-next__priorities", role: "list" do %>
    <% plan[:proximos_passos].each_with_index do |passo, index| %>
      <li>
        <span class="apr-steps__num" aria-hidden="true"><%= index + 1 %></span>
        <div>
          <h3 class="apr-steps__title"><%= passo[:titulo] %></h3>
          <p class="apr-steps__text"><%= passo[:texto] %></p>
        </div>
      </li>
    <% end %>
  <% end %>
</div>
<%= presentation_update_note("planejamento.yml", "marco visual e próximos passos.") %>
