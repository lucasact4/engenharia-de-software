<% r = presentation.requisitos %>
<%= render "presentations/shared/heading", slide: slide,
      kicker: "escopo do MVP e regras",
      title: "Uma ocorrência, quatro dimensões independentes",
      lead: r[:regra_dimensoes] %>

<%= presentation_item slide, "dimensoes", class: "apr-dimensions", role: "list" do %>
  <% r[:dimensoes].each do |dimensao| %>
    <article class="apr-dimension" role="listitem">
      <p class="apr-dimension__q"><%= dimensao[:pergunta] %></p>
      <h3 class="apr-dimension__name"><%= dimensao[:nome] %></h3>
      <% if dimensao[:exemplos].present? %>
        <ul class="apr-dimension__values" role="list" aria-label="Valores de exemplo">
          <% dimensao[:exemplos].each do |exemplo| %>
            <li><%= exemplo %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="apr-dimension__empty">Valores a definir</p>
      <% end %>
      <%= presentation_state(dimensao[:estado]) %>
      <p class="apr-dimension__note"><%= dimensao[:nota] %></p>
    </article>
  <% end %>
<% end %>

<%= presentation_item slide, "conflitos", class: "apr-conflicts" do %>
  <div class="apr-conflicts__head">
    <h3 class="apr-conflicts__title">Conflitos em aberto</h3>
    <%= presentation_state(:aguardando_decisao) %>
    <%= presentation_link("Card ##{r.dig(:card_refinamento, :numero)}", r.dig(:card_refinamento, :url), class: "apr-card-link") %>
    <%= presentation_slide_ref "conflitos", :a, class: "apr-more", href: "#s-conflitos" do %>Detalhes no apêndice<% end %>
  </div>
  <ul class="apr-conflicts__list" role="list">
    <% r[:conflitos].each do |conflito| %>
      <li><strong><%= conflito[:id] %></strong> <span><%= conflito[:tema] %></span></li>
    <% end %>
  </ul>
<% end %>
<%= presentation_update_note("requisitos.yml", "dimensões e conflitos. A lista de requisitos refinados fica no slide próprio.") %>
