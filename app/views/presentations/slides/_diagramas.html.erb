<% d = presentation.diagramas %>
<%= render "presentations/shared/heading", slide: slide,
      kicker: "modelagem",
      title: "Modelo conceitual e diagramas",
      lead: "Três artefatos distintos: o fluxograma não substitui o modelo conceitual nem o diagrama de casos de uso." %>

<div class="apr-diagrams">
  <% d[:itens].each do |item| %>
    <article class="apr-diagram <%= 'apr-diagram--required' if item[:exigido_na_entrega] %>" aria-labelledby="<%= slide.dom_id %>-<%= item[:id] %>">
      <header class="apr-diagram__head">
        <h3 id="<%= slide.dom_id %>-<%= item[:id] %>" class="apr-diagram__title"><%= item[:titulo] %></h3>
        <% if item[:exigido_na_entrega] %><span class="apr-tag apr-tag--gold">Exigido na 2ª entrega</span><% end %>
      </header>

      <% if item[:imagem].present? %>
        <%= render "presentations/shared/figure",
              image: item[:imagem], alt: "#{item[:titulo]}: #{item[:descricao]}",
              caption: [ item[:titulo], item[:versao] && "versão #{item[:versao]}" ].compact.join(" · "),
              state: item[:estado], modifier: "apr-figure--diagram" %>
        <p class="apr-diagram__meta">
          <%= [ item[:origem], presentation_date(item[:data]) ].compact_blank.join(" · ") %>
        </p>
      <% else %>
        <%= render "presentations/shared/pending",
              title: item[:descricao],
              state: item[:estado],
              card: item[:card],
              frame: true %>
      <% end %>
    </article>
  <% end %>
</div>

<p class="apr-source">
  O DER físico (tabelas reais de <code>db/schema.rb</code>) é um artefato separado do modelo conceitual e do fluxo —
  <a class="apr-more" href="#s-modelo-conceitual">ver modelo conceitual ampliado</a> e
  <a class="apr-more" href="#s-modelo-dados">apêndices do DER</a>.
</p>
<%= presentation_update_note("diagramas.yml", "imagem, versao, origem e data de cada diagrama.") %>
