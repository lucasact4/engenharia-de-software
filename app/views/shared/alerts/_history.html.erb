<% entries = detail.history %>
<section class="sgu-card p-5 sm:p-6" aria-labelledby="alert_<%= detail.alert.id %>_history">
  <h2 id="alert_<%= detail.alert.id %>_history" class="sgu-section-title flex items-center gap-2"><%= sgu_icon("history") %> Histórico</h2>
  <% if entries.empty? %>
    <p class="mt-3 text-sm text-muted">Sem eventos registrados.</p>
  <% else %>
    <ol class="mt-4 space-y-4 border-l-2 border-line pl-5">
      <% entries.each do |entry| %>
        <li class="relative">
          <span class="absolute -left-[1.6rem] top-1.5 size-2.5 rounded-full bg-brand-solid" aria-hidden="true"></span>
          <p class="text-sm font-semibold text-ink"><%= entry[:title] %></p>
          <p class="text-xs text-muted"><%= sgu_time(entry[:at]) %><% if entry[:actor] %> · <%= entry[:actor] %><% end %></p>
          <% entry[:details].each do |detail_line| %>
            <p class="text-sm text-ink"><%= detail_line %></p>
          <% end %>
          <% if entry[:reason].present? %>
            <p class="mt-1 rounded-lg bg-surface-muted px-3 py-2 text-sm text-ink"><span class="font-semibold">Motivo:</span> <%= entry[:reason] %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% end %>
</section>
