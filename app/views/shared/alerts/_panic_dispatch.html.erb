<%# RNF001: entrega do alerta de pânico (push e e-mail) com o tempo desde o pedido, e o aviso público no mural. %>
<% deliveries = alert.panic_deliveries.includes(:user).chronological.to_a %>
<% first_sent = deliveries.select(&:sent?).min_by(&:latency_ms) %>
<section class="sgu-card space-y-4 p-5" aria-labelledby="panic-dispatch-title">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="panic-dispatch-title" class="text-lg font-bold text-ink">Envio do alerta de emergência</h2>
      <p class="text-sm text-muted">Meta do RNF001: o primeiro aviso sai em até <%= PanicDelivery::TARGET_MS / 1000 %> s após o pedido.</p>
    </div>
    <% if first_sent %>
      <p class="rounded-full px-3 py-1 text-sm font-bold <%= first_sent.within_target? ? 'bg-positive-soft text-positive-ink' : 'bg-negative-soft text-negative-ink' %>">
        Primeiro aviso em <%= number_with_precision(first_sent.seconds, precision: 1, separator: ",") %> s <%= first_sent.within_target? ? "· dentro da meta" : "· acima da meta" %>
      </p>
    <% else %>
      <p class="rounded-full bg-surface-muted px-3 py-1 text-sm font-semibold text-muted">Aguardando o envio</p>
    <% end %>
  </div>

  <% if alert.public_warning? %>
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-negative-line bg-negative-soft p-3 text-sm text-negative-ink">
      <% if alert.public_warning_active? %>
        <p><strong>Aviso público ativo</strong> no topo do mural, sem o nome do autor e com o local aproximado.</p>
        <% if policy(alert).withdraw_public_warning? %>
          <%= button_to "Retirar aviso do mural", public_warning_handling_alert_path(alert), method: :patch,
                class: "sgu-btn sgu-btn-sm sgu-btn-secondary", form: { data: { turbo_confirm: "Retirar este aviso público do mural?" } } %>
        <% end %>
      <% elsif alert.public_warning_withdrawn_at %>
        <p>Aviso público retirado do mural em <%= l(alert.public_warning_withdrawn_at, format: :short) %><%= " por #{alert.public_warning_withdrawn_by&.display_name || alert.public_warning_withdrawn_by&.email_address}" if alert.public_warning_withdrawn_by %>.</p>
      <% else %>
        <p>Aviso público encerrado: o pedido foi concluído ou passou da janela de <%= Alert::PUBLIC_WARNING_WINDOW.in_hours.to_i %> h.</p>
      <% end %>
    </div>
  <% end %>

  <% if deliveries.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-xs uppercase tracking-wide text-muted">
          <tr><th class="py-2 pr-3">Canal</th><th class="py-2 pr-3">Destinatário</th><th class="py-2 pr-3">Tempo</th><th class="py-2">Situação</th></tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% deliveries.each do |delivery| %>
            <tr>
              <td class="py-2 pr-3 font-semibold"><%= delivery.channel == "push" ? "Push" : "E-mail" %></td>
              <td class="py-2 pr-3"><%= delivery.user.display_name.presence || delivery.user.email_address %></td>
              <td class="py-2 pr-3 font-mono"><%= number_with_precision(delivery.seconds, precision: 1, separator: ",") %> s</td>
              <td class="py-2">
                <% if delivery.sent? %>
                  <span class="<%= delivery.within_target? ? 'text-positive-ink' : 'text-negative-ink' %>">Entregue ao serviço<%= " · acima da meta" unless delivery.within_target? %></span>
                <% else %>
                  <span class="text-negative-ink">Falhou<%= ": #{delivery.error_message}" if delivery.error_message %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-muted">“Entregue ao serviço” significa aceito pelo serviço de push ou de e-mail; não confirma que a pessoa já viu o aviso.</p>
  <% else %>
    <p class="text-sm text-muted">Nenhum push ou e-mail registrado ainda. Sem chaves de push configuradas ou sem dispositivos ativados, só o aviso no sino é enviado.</p>
  <% end %>
</section>
