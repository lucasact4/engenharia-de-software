<% alert = detail.alert %>
<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
  <div class="min-w-0">
    <p class="sgu-eyebrow"><%= alert.panic? ? "Pedido de pânico" : "Ocorrência" %> · <span class="font-mono normal-case tracking-normal"><%= alert.protocol %></span></p>
    <h1 class="sgu-page-title mt-1 break-words"><%= alert.title.presence || "Pedido de ajuda (pânico)" %></h1>
    <div class="mt-3 flex flex-wrap gap-2">
      <%= alert_status_badge(alert) %>
      <% if detail.operational? %>
        <%= alert_priority_badge(alert) %>
        <% if alert.publication_blocked? %><span class="sgu-badge sgu-badge-red"><%= sgu_icon("lock", "size-3") %> Divulgação bloqueada</span><% end %>
      <% end %>
      <span class="sgu-badge sgu-badge-slate"><%= sgu_icon("lock", "size-3") %> Visibilidade: <%= enum_label("alert.visibility", alert.visibility) %></span>
    </div>
  </div>
  <div class="flex shrink-0 flex-wrap gap-2">
    <%= yield if block_given? %>
  </div>
</div>
