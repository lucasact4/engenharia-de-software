<div data-controller="password-strength" class="space-y-4">
  <div data-controller="password-toggle">
    <%= form.label :password, "Senha", class: "sgu-label" %>
    <div class="relative">
      <%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", class: "sgu-input pr-12", spellcheck: false,
          data: { password_toggle_target: "input", password_strength_target: "password", action: "input->password-strength#update" }, aria: { describedby: "password_requirements password_strength" } %>
      <button type="button" class="absolute inset-y-0 right-0 px-4 text-muted" data-action="password-toggle#toggle" aria-label="Mostrar senha">
        <span data-password-toggle-target="showIcon"><%= icon("eye", class: "size-5", "aria-hidden": true) %></span>
        <span class="hidden" data-password-toggle-target="hideIcon"><%= icon("eye-off", class: "size-5", "aria-hidden": true) %></span>
      </button>
    </div>
    <div class="password-meter" aria-hidden="true"><div class="password-meter__fill" data-password-strength-target="meter"></div></div>
    <p id="password_strength" class="sgu-hint" data-password-strength-target="feedback" aria-live="polite">Crie uma senha que atenda aos requisitos abaixo.</p>
    <ul id="password_requirements" class="password-rules">
      <% [["length", "Pelo menos 8 caracteres"], ["upper", "Uma letra maiúscula"], ["lower", "Uma letra minúscula"], ["number", "Um número"], ["symbol", "Um símbolo (ex.: !@#)"], ["bytes", "Até 72 bytes"]].each do |rule, label| %>
        <li data-password-strength-target="rule" data-rule="<%= rule %>" data-valid="false"><span class="password-rule-mark" aria-hidden="true">·</span><span><%= label %></span><span class="sr-only" data-rule-status>pendente</span></li>
      <% end %>
    </ul>
    <p class="sgu-hint">Acentos e outros caracteres podem ocupar mais de um byte.</p>
  </div>
  <div data-controller="password-toggle">
    <%= form.label :password_confirmation, "Confirmar senha", class: "sgu-label" %>
    <div class="relative">
      <%= form.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", class: "sgu-input pr-12", spellcheck: false,
          data: { password_toggle_target: "input", password_strength_target: "confirmation", action: "input->password-strength#update" }, aria: { describedby: "password_confirmation_feedback" } %>
      <button type="button" class="absolute inset-y-0 right-0 px-4 text-muted" data-action="password-toggle#toggle" aria-label="Mostrar senha">
        <span data-password-toggle-target="showIcon"><%= icon("eye", class: "size-5", "aria-hidden": true) %></span>
        <span class="hidden" data-password-toggle-target="hideIcon"><%= icon("eye-off", class: "size-5", "aria-hidden": true) %></span>
      </button>
    </div>
    <p id="password_confirmation_feedback" class="sgu-hint" data-password-strength-target="confirmationFeedback" aria-live="polite">Repita a mesma senha.</p>
  </div>
</div>
