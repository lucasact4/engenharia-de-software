<% latitude = coordinates.fetch(:latitude).to_f %>
<% longitude = coordinates.fetch(:longitude).to_f %>
<% disclosure_id = "shared_location_#{SecureRandom.hex(8)}" %>
<div class="mt-4" data-controller="location-disclosure" aria-label="<%= label %>">
  <button type="button" class="sgu-btn sgu-btn-secondary sgu-btn-sm" aria-expanded="false"
          aria-controls="<%= disclosure_id %>"
          data-location-disclosure-target="button" data-action="location-disclosure#toggle">Mostrar Localização</button>
  <div id="<%= disclosure_id %>" hidden data-location-disclosure-target="panel">
    <section class="mt-2 overflow-hidden rounded-xl border border-line" aria-label="<%= label %>">
      <h3 class="px-3 py-2 text-sm font-semibold text-ink"><%= label %></h3>
      <div class="h-56 w-full" data-controller="location-preview" data-location-preview-latitude-value="<%= latitude %>" data-location-preview-longitude-value="<%= longitude %>" aria-label="Mapa da localização compartilhada"></div>
      <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 text-xs text-muted">
        <span><%= format("%.6f, %.6f", latitude, longitude) %></span>
        <%= link_to "Abrir no Google Maps ↗", "https://www.google.com/maps/search/?api=1&query=#{latitude},#{longitude}", target: "_blank", rel: "noopener noreferrer", class: "sgu-link" %>
      </div>
    </section>
  </div>
</div>
