<% content_for :title, "Salvos - SGU UFRPE" %>
<div class="profile-page">
  <%= back_link profile_path, "seu perfil" %>
  <%= render "profiles/own_header", user: @user, posts_count: @posts_count, followers_count: @followers_count, following_count: @following_count %>
  <%= render "profiles/own_tabs", active: :saved %>

  <div class="profile-saved-bar">
    <h1 class="sr-only">Salvos</h1>
    <p><%= sgu_icon("lock", "size-4") %> Somente você pode ver o que salvou</p>
    <%= link_to publications_path, class: "profile-saved-link" do %>Explorar o mural <%= sgu_icon("chevron-right", "size-4") %><% end %>
  </div>

  <% if @unavailable.positive? %>
    <div class="profile-saved-warning">
      <p><%= pluralize(@unavailable, "item salvo não está mais disponível", plural: "itens salvos não estão mais disponíveis") %>.</p>
      <%= button_to "Remover indisponíveis", prune_follow_ups_path(tipo: "salvos"), method: :delete, class: "sgu-btn sgu-btn-sm sgu-btn-secondary" %>
    </div>
  <% end %>

  <%= render "profiles/grid", cards: @grid_cards, pagy: @pagy, empty_icon: "bookmark",
        empty_title: "Salve o que quiser rever",
        empty_text: "Use Salvar em uma publicação do mural. Se ela sair do ar ou deixar de estar disponível para você, ela some daqui." %>
</div>
