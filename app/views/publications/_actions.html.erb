<%# Ações da publicação (estado vem de PublicationProjection). POST adiciona e DELETE remove:
    repetir a mesma ação não alterna o estado. %>
<% state = card[:viewer_state] %>
<div id="publication_<%= card[:id] %>_actions" class="flex flex-wrap items-center gap-2">
  <% if state %>
    <% [ [ :like, "heart", "Curtir", "Curtido", card[:likes_count] ], [ :bookmark, "bookmark", "Salvar", "Salvo", nil ], [ :subscription, "bell", "Acompanhar", "Acompanhando", nil ] ].each do |kind, icon_name, label, active_label, count| %>
      <% active = state[{ like: :liked, bookmark: :bookmarked, subscription: :subscribed }[kind]] %>
      <% path = send("publication_#{kind}_interaction_path", card[:id]) %>
      <%= button_to path, method: (active ? :delete : :post), class: "sgu-btn sgu-btn-sm sgu-btn-secondary sgu-btn-toggle", form_class: "inline",
            aria: { pressed: active, label: "#{active ? active_label : label}#{count ? " (#{count})" : ''}" },
            title: { like: "Curtir publicação", bookmark: "Guardar em Salvos (privado)", subscription: "Acompanhar esta publicação e a conversa" }[kind] do %>
        <%= sgu_icon(icon_name) %><span><%= active ? active_label : label %></span><% if count %><span class="text-muted"><%= count %></span><% end %>
      <% end %>
    <% end %>
  <% else %>
    <span class="sgu-badge sgu-badge-slate"><%= sgu_icon("heart", "size-3") %> <%= pluralize(card[:likes_count], "curtida", plural: "curtidas") %></span>
  <% end %>
  <%= link_to publication_path(card[:id], anchor: "comentarios"), class: "sgu-btn sgu-btn-sm sgu-btn-ghost" do %>
    <%= sgu_icon("message-circle") %><span><%= pluralize(card[:comments_count], "comentário", plural: "comentários") %></span>
  <% end %>
  <% if state && local_assigns[:show_report] %>
    <%= link_to new_publication_content_report_path(card[:id]), class: "sgu-btn sgu-btn-sm sgu-btn-ghost ml-auto", title: "Denunciar à administração" do %>
      <%= sgu_icon("flag") %><span>Denunciar</span>
    <% end %>
  <% elsif !state %>
    <%= link_to "Entre para interagir", new_session_path(locale: nil, return_to: publication_path(card[:id], locale: nil)), class: "sgu-link ml-auto text-sm" %>
  <% end %>
</div>
