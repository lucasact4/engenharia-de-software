<% map = local_assigns[:map] %>
<% filters = map ? @map_filters : params %>
<dialog id="mural-search" class="mural-search-dialog" open data-mural-shell-target="searchDialog" data-action="click->mural-shell#closeBackdrop" aria-labelledby="mural-search-title">
  <div class="mural-search-content">
    <header class="mural-panel-heading">
      <div><p class="mural-eyebrow">Encontre no campus</p><h2 id="mural-search-title"><%= map ? "Filtrar mapa" : "Pesquisar publicações" %></h2></div>
      <button type="button" class="social-icon-button" data-action="mural-shell#closeSearch" aria-label="Fechar pesquisa"><%= sgu_icon("x", "size-5") %></button>
    </header>
    <%= form_with url: map ? campus_map_path : publications_path, method: :get, class: "mural-search-form", data: { turbo_action: "advance" }, aria: { label: map ? "Filtros do mapa de ocorrências" : "Busca e filtros do mural" } do %>
      <% unless map %>
        <div><%= label_tag :q, "Palavras-chave ou ID/protocolo", class: "sgu-label" %><%= search_field_tag :q, params[:q], class: "sgu-input", placeholder: "O que você procura?", data: { mural_shell_target: "searchField" } %></div>
        <div><%= label_tag :creator, "Criador", class: "sgu-label" %><%= search_field_tag :creator, params[:creator], class: "sgu-input", placeholder: "Nome de quem publicou", aria: { describedby: "creator_privacy_hint" } %></div>
        <p id="creator_privacy_hint" class="mural-search-hint">A busca por criador considera somente a identidade visível para você.</p>
      <% end %>
      <% if map %>
        <div><%= label_tag :category_id, "Categoria", class: "sgu-label" %><%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, filters[:category_id]), include_blank: "Todas as categorias", class: "sgu-input" %></div>
      <% else %>
        <fieldset class="mural-search-categories">
          <legend class="sgu-label">Categorias <span>(escolha uma ou mais)</span></legend>
          <div>
            <% @categories.each do |category| %>
              <label class="mural-check-chip" title="<%= category.name %>">
                <%= check_box_tag "category_ids[]", category.id, @selected_category_ids.include?(category.id), id: "search_category_#{category.id}" %>
                <%= mural_category_icon(category, "size-4") %><span><%= category.name %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
      <% if map %>
        <div><%= label_tag :status, "Situação", class: "sgu-label" %><%= select_tag :status, options_for_select(@map_statuses.map { |status| [ enum_label("alert.status", status), status ] }, filters[:status]), include_blank: "Todas as situações ativas", class: "sgu-input" %></div>
      <% end %>
      <div>
        <%= label_tag :severity, map ? "Severidade percebida" : "Gravidade", class: "sgu-label" %>
        <% choices = map ? @map_severities.map { |severity| [ enum_label("alert.severity", severity), severity ] } + [ [ "Não informada", "not_reported" ] ] : Alert.reported_severities.keys.map { |value| [ enum_label("alert.severity", value), value ] } %>
        <%= select_tag :severity, options_for_select(choices, filters[:severity]), include_blank: "Todas as gravidades", class: "sgu-input" %>
      </div>
      <% unless map %>
        <div><%= label_tag :kind, "Tipo de publicação", class: "sgu-label" %><%= select_tag :kind, options_for_select([ [ "Tudo", "" ], [ "Ocorrências", "occurrence" ], [ "Notícias", "news" ], [ "Avisos", "notice" ] ], params[:kind]), class: "sgu-input" %></div>
        <% if Current.user %><div><%= label_tag :audience, "Audiência", class: "sgu-label" %><%= select_tag :audience, options_for_select([ [ "Todas", "" ], [ "Públicas", "public_external" ], [ "Internas", "internal" ] ], params[:audience]), class: "sgu-input" %></div><% end %>
      <% end %>
      <div class="mural-search-actions">
        <%= link_to "Limpar filtros", map ? campus_map_path : publications_path, class: "sgu-btn sgu-btn-secondary" %>
        <button type="submit" class="sgu-btn sgu-btn-primary"><%= sgu_icon("search") %><%= map ? "Filtrar mapa" : "Aplicar filtros" %></button>
      </div>
    <% end %>
  </div>
</dialog>
