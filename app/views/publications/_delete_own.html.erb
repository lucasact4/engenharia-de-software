<% if policy(publication).delete_own? %>
  <% word = %w[arvore ponte campo nuvem pedra trilha jardim rio].sample(random: SecureRandom) %>
  <% challenge = Rails.application.message_verifier(:publication_deletion).generate(
       [Current.user.id, publication.id, word], purpose: :delete_own_publication, expires_in: 15.minutes
     ) %>
  <details class="sgu-card mt-4 p-4">
    <summary class="cursor-pointer font-semibold text-negative-ink">Apagar postagem</summary>
    <%= form_with url: publication_path(publication), method: :delete, class: "mt-3 space-y-3" do |form| %>
      <p>Esta ação retira a postagem do mural. O registro permanece no histórico de atendimento.</p>
      <%= form.hidden_field :challenge, value: challenge %>
      <%= form.label :confirmation, "Digite #{word} para confirmar", class: "sgu-label" %>
      <%= form.text_field :confirmation, required: true, autocomplete: "off", spellcheck: false, class: "sgu-input" %>
      <%= form.submit "Confirmar exclusão", class: "sgu-btn sgu-btn-secondary" %>
    <% end %>
  </details>
<% end %>
