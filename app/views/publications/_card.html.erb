<% person = card[:author] %>
<article class="social-post <%= 'social-post-full' if local_assigns[:full] %>" aria-labelledby="post_title_<%= card[:id] %>">
  <header class="social-post-header">
    <span class="social-avatar" aria-hidden="true"><% if person[:avatar_id] %><%= image_tag profile_photo_path(person[:avatar_id]), alt: "", class: "size-full rounded-full object-cover", loading: "lazy" %><% else %><%= initials_for(person[:display_name]) %><% end %></span>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5">
        <% if person[:public_profile] %><%= link_to person[:display_name], person_path(person[:id]), class: "social-author" %><% else %><span class="social-author"><%= person[:display_name] %></span><% end %>
        <% if person[:verified] %><%= render "shared/verified_badge" %><% end %>
      </div>
      <p class="social-post-meta"><span><%= card[:kind_label] %></span><span aria-hidden="true">·</span><%= sgu_time(card[:published_at], format: "%d/%m · %H:%M") %></p>
    </div>
    <span class="social-visibility" title="<%= card[:visibility] == 'internal' ? 'Visível somente para contas conectadas' : 'Visível também sem login' %>"><%= sgu_icon(card[:visibility] == 'internal' ? "lock" : "globe") %><span class="sr-only"><%= card[:visibility] == 'internal' ? 'Publicação interna' : 'Publicação pública' %></span></span>
    <% unless local_assigns[:preview] %>
      <details class="social-post-menu" data-controller="disclosure" data-action="click@window->disclosure#outside keydown.esc->disclosure#close">
        <summary class="social-icon-button" aria-label="Opções da publicação" title="Opções da publicação"><span class="social-post-ellipsis" aria-hidden="true">•••</span></summary>
        <div class="social-post-menu-panel">
          <%= link_to publication_path(card[:id]), class: "social-post-menu-link" do %><%= sgu_icon("newspaper") %> Ver publicação<% end %>
          <% if card[:own_review] %><%= link_to edit_alert_path(card[:own_review][:alert_id]), class: "social-post-menu-link" do %><%= sgu_icon("square-pen") %> Editar minha ocorrência<% end %><% end %>
          <% if card[:viewer_state] %><%= link_to new_publication_content_report_path(card[:id]), class: "social-post-menu-link social-post-menu-report" do %><%= sgu_icon("flag") %> Denunciar publicação<% end %><% elsif !local_assigns[:preview] %><%= link_to new_session_path(locale: nil, return_to: publication_path(card[:id], locale: nil)), class: "social-post-menu-link social-post-menu-report", rel: "nofollow" do %><%= sgu_icon("flag") %> Denunciar publicação<% end %><% end %>
        </div>
      </details>
    <% end %>
  </header>
  <% if card[:photos].any? %>
    <div class="post-gallery" data-controller="post-gallery" aria-label="Fotos da publicação">
      <div class="post-gallery-track" data-post-gallery-target="track" data-action="scroll->post-gallery#update">
        <% card[:photos].each_with_index do |photo, index| %>
          <figure class="post-gallery-slide" data-post-gallery-target="slide"><%= image_tag publication_media_path(publication_id: card[:id], id: photo[:id]), alt: "Foto #{index + 1} de #{card[:photos].size}: #{card[:title]}", loading: "lazy", decoding: "async" %></figure>
        <% end %>
      </div>
      <% if card[:photos].size > 1 %>
        <button type="button" class="post-gallery-prev" data-post-gallery-target="previous" data-action="post-gallery#previous" aria-label="Foto anterior"><%= sgu_icon("chevron-left") %></button>
        <button type="button" class="post-gallery-next" data-post-gallery-target="next" data-action="post-gallery#next" aria-label="Próxima foto"><%= sgu_icon("chevron-right") %></button>
        <span class="post-gallery-count" data-post-gallery-target="count" aria-live="polite">1 / <%= card[:photos].size %></span>
        <div class="post-gallery-dots" aria-label="Escolher foto da publicação">
          <% card[:photos].each_with_index do |photo, index| %>
            <button type="button" class="post-gallery-dot" data-post-gallery-target="dot" data-index="<%= index %>" data-action="post-gallery#go"
                    aria-label="Ir para foto <%= index + 1 %>" aria-current="<%= index.zero? %>"></button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="social-post-content">
    <% unless local_assigns[:preview] %><%= render "publications/actions", card: card, show_report: true %><% end %>
    <% unless card[:kind] == 'occurrence' && card[:title] == card[:body] %><h2 id="post_title_<%= card[:id] %>" class="social-post-title"><%= card[:title] %></h2><% else %><h2 id="post_title_<%= card[:id] %>" class="sr-only"><%= card[:title] %></h2><% end %>
    <div class="social-caption" data-controller="post-caption" data-post-caption-full-value="<%= !!local_assigns[:full] %>">
      <p id="post_caption_<%= card[:id] %>" class="social-caption-text" data-post-caption-target="text"><strong><%= person[:display_name] %></strong> <%= card[:body] %></p>
      <button type="button" class="social-caption-toggle" data-post-caption-target="toggle" data-action="post-caption#toggle"
              aria-expanded="false" aria-controls="post_caption_<%= card[:id] %>" hidden>Ver mais</button>
    </div>
    <% if card[:location_description].present? %>
      <p class="text-sm text-muted"><strong>Local informado:</strong> <%= card[:location_description] %></p>
    <% elsif card[:location].present? %>
      <%= render "shared/exact_location", coordinates: card[:location], label: "Localização compartilhada pelo autor" %>
    <% end %>
    <% if card[:own_review] && card[:own_review][:requested] == 'public_external' && card[:own_review][:status] != 'approved' %>
      <p class="mt-3 text-xs text-warning-ink"><%= card[:own_review][:status] == 'rejected' ? 'Publicação pública não aprovada' : 'Aguardando aprovação para aparecer publicamente' %></p>
      <% if card[:own_review][:reason].present? %><p class="mt-1 text-sm text-muted">Motivo: <%= card[:own_review][:reason] %></p><% end %>
    <% end %>
    <% unless local_assigns[:preview] || local_assigns[:full] %>
      <%= link_to(card[:comments_count].positive? ? "Ver #{pluralize(card[:comments_count], 'comentário', plural: 'comentários')}" : "Seja a primeira pessoa a comentar",
            publication_path(card[:id], anchor: 'comentarios'), class: "social-post-comments") %>
    <% end %>
  </div>
</article>
