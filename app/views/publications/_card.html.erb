<article class="sgu-card publication-feed-card p-5 sm:p-6" id="publication_card_<%= card[:id] %>" aria-labelledby="publication_card_<%= card[:id] %>_title">
  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-muted">
    <span class="sgu-badge sgu-badge-teal"><%= card[:kind_label] %></span>
    <% if card[:visibility] == "internal" %><span class="sgu-badge sgu-badge-slate"><%= sgu_icon("lock", "size-3") %> Interna</span><% end %>
    <span><%= card[:editorial_identity] %> · <%= sgu_time(card[:published_at], format: "%d/%m/%Y") %></span>
    <% if card[:expires_at] %><span>· válido até <%= sgu_time(card[:expires_at], format: "%d/%m/%Y %H:%M") %></span><% end %>
  </div>
  <h2 id="publication_card_<%= card[:id] %>_title" class="mt-3 text-lg font-bold text-ink sm:text-xl">
    <%= link_to card[:title], publication_path(card[:id]), class: "!text-ink hover:!text-brand-link" %>
  </h2>
  <p class="mt-2 leading-7 text-ink"><%= excerpt(card[:body]) %></p>
  <div class="mt-4 border-t border-line pt-4">
    <%= render "publications/actions", card: card, show_report: true %>
  </div>
</article>
