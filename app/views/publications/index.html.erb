<% content_for :title, "Mural - SGU UFRPE" %>
<% warnings = Alert.active_public_warnings.includes(:location).limit(3).to_a %>
<% selected_ids = @selected_category_ids %>
<% selected_categories = @categories.select { |category| selected_ids.include?(category.id) } %>
<% filter_count = %i[q creator severity kind audience].count { |key| params[key].present? } + selected_ids.size %>
<div class="mural-page">
  <div class="mural-timeline">
    <header class="mural-feed-heading">
      <h1>Mural do campus</h1>
      <button type="button" class="mural-filter-trigger" data-action="mural-shell#openSearch"><%= sgu_icon("search", "size-4") %><span><%= filter_count.positive? ? "#{filter_count} filtros" : "Pesquisar" %></span></button>
    </header>

    <nav class="mural-categories" aria-label="Filtrar por categoria (é possível escolher várias)"
         data-controller="floating-tooltip" data-action="mouseover->floating-tooltip#show focusin->floating-tooltip#show mouseout->floating-tooltip#hide focusout->floating-tooltip#hide">
      <%= link_to mural_categories_path([]), class: "mural-category #{'is-active' if selected_ids.empty?}",
            data: { tooltip: selected_ids.empty? ? "Mostrando todas as categorias" : "Limpar categorias e mostrar tudo" },
            aria: { label: "Tudo: todas as categorias", current: ("page" if selected_ids.empty?) } do %>
        <span class="mural-category-ring"><span><%= sgu_brand(:symbol, alt: "", class_name: "h-7") %></span></span><span>Tudo</span>
      <% end %>
      <% @categories.each do |category| %>
        <% selected = selected_ids.include?(category.id) %>
        <%= link_to mural_category_toggle_path(category.id, selected_ids), class: "mural-category #{'is-active' if selected}",
              data: { tooltip: "#{category.name} · #{selected ? 'clique para remover' : 'clique para adicionar'}" },
              aria: { label: "#{category.name}: #{selected ? 'selecionada, remover do filtro' : 'adicionar ao filtro'}", pressed: selected } do %>
          <span class="mural-category-ring"><span><%= mural_category_icon(category) %></span><% if selected %><span class="mural-category-check"><%= sgu_icon("check", "size-3") %></span><% end %></span><span><%= category.name %></span>
        <% end %>
      <% end %>
    </nav>
    <% if selected_categories.any? %>
      <div class="mural-category-chips" aria-label="Categorias selecionadas">
        <span><%= selected_categories.one? ? "Categoria:" : "#{selected_categories.size} categorias:" %></span>
        <% selected_categories.each do |category| %>
          <%= link_to mural_category_toggle_path(category.id, selected_ids), class: "mural-category-chip", aria: { label: "Remover #{category.name} do filtro" }, title: "Remover #{category.name}" do %><%= category.name %> <%= sgu_icon("x", "size-3") %><% end %>
        <% end %>
        <%= link_to "Limpar", mural_categories_path([]), class: "mural-category-clear" %>
      </div>
    <% end %>

    <%= render "publications/mural_safety_strip", warnings: warnings %>
    <% if filter_count.positive? %><p class="mural-filter-summary">Resultados filtrados <%= link_to "Limpar filtros", publications_path %></p><% end %>
    <% unless Current.user %><p class="mural-guest-note"><%= link_to "Entre", new_session_path(return_to: publications_path) %> para ver publicações internas e interagir.</p><% end %>

    <div class="mural-posts"><% @cards.each do |card| %><%= render "publications/card", card: card %><% end %></div>
    <% if @cards.empty? %>
      <div class="sgu-empty"><p><%= filter_count.positive? ? "Nada encontrado com esses filtros." : "Ainda não há publicações." %></p>
        <% if filter_count.positive? %><%= link_to "Limpar filtros", publications_path, class: "sgu-link" %><% end %>
      </div>
    <% end %>
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
  <%= render "publications/mural_context", warnings: warnings %>
</div>
<%= render "publications/mural_search" %>
