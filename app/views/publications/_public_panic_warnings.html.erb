<%# Pânicos que o autor pediu para tornar públicos: ficam no topo do mural enquanto estão em aberto
    (até 12 h) e somem quando a equipe retira o aviso ou encerra o pedido. Sem autor e sem GPS exato. %>
<% warnings = local_assigns.fetch(:warnings) { Alert.active_public_warnings.includes(:location).limit(3).to_a } %>
<% if warnings.any? %>
  <section class="public-warnings mt-5 space-y-3" aria-labelledby="public-warnings-title">
    <h2 id="public-warnings-title" class="flex items-center gap-2 text-sm font-extrabold uppercase tracking-wider text-negative-ink">
      <%= sgu_icon("siren", "size-4") %> Alertas de segurança ativos
    </h2>
    <% warnings.each do |alert| %>
      <article class="public-warning" aria-label="Alerta de segurança <%= alert.protocol %>">
        <span class="public-warning__icon" aria-hidden="true"><%= sgu_icon("siren", "size-6") %></span>
        <div class="min-w-0 space-y-1.5">
          <p class="public-warning__eyebrow">
            Alerta de segurança · <%= enum_label("alert.status", alert.status) %>
          </p>
          <p class="public-warning__text"><%= alert.description %></p>
          <p class="public-warning__meta">
            <span class="inline-flex items-center gap-1"><%= sgu_icon("map-pin", "size-3.5") %> <%= public_warning_place(alert) %></span>
            <span aria-hidden="true">·</span>
            <time datetime="<%= alert.created_at.iso8601 %>">há <%= time_ago_in_words(alert.created_at) %></time>
          </p>
          <p class="public-warning__advice">A equipe de segurança foi acionada. Evite a área; em risco imediato, procure ajuda presencial ou ligue 190.</p>
        </div>
      </article>
    <% end %>
  </section>
<% end %>
