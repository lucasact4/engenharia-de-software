<% pending_panics = notification_feed.unread.where(kind: "panic") %>
<% urgent = pending_panics.order(:created_at, :id).first %>
<aside class="notification-urgent" data-notifications-target="urgent" data-urgent-id="<%= urgent&.id %>"
       data-urgent-version="<%= pending_panics.maximum(:id) if urgent %>" aria-live="assertive" aria-relevant="additions" <%= 'hidden' unless urgent %>>
  <%= render "notifications/urgent", notification: urgent if urgent %>
</aside>
