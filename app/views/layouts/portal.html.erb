<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <%= render "shared/theme_head" %>
    <title><%= content_for(:title) || "SGU UFRPE" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% if controller_name == "notifications" %><meta name="turbo-cache-control" content="no-cache"><% end %>
    <meta name="description" content="SGU UFRPE: registro e acompanhamento de ocorrências e mural de comunicados do campus.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "favicon.png" %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(locale: nil) %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% body_data = { controller: [ ("notifications" if Current.user), "mural-shell", "title-tooltip" ].compact.join(" ") } %>
  <% body_data[:notifications_url_value] = notifications_path(format: :json) if Current.user %>
  <body class="min-h-dvh bg-canvas text-ink antialiased mural-shell mural-shell--compact" <%= tag.attributes(data: body_data) %>>
    <a href="#conteudo" class="sr-only z-[60] rounded-lg bg-surface px-4 py-2 font-semibold focus:not-sr-only focus:fixed focus:left-3 focus:top-3">Pular para o conteúdo</a>
    <%= render "layouts/portal/mural_navigation" %>
    <%= render "notifications/popup" if Current.user %>

    <main id="conteudo" class="mural-main">
      <%= render "layouts/portal/flash" %>
      <div class="<%= 'portal-page' unless controller_name.in?(%w[publications campus_map]) %>"><%= yield %></div>
    </main>

  </body>
</html>
