<div id="hs-application-sidebar"
     class="admin-sidebar hs-overlay [--auto-close:lg] hs-overlay-open:translate-x-0 -translate-x-full fixed inset-y-0 start-0 z-50 hidden h-full w-[86vw] max-w-72 transform overflow-hidden border-e border-line bg-surface transition-all duration-300 lg:block lg:w-64 lg:translate-x-0"
     role="dialog"
     tabindex="-1"
     aria-label="Sidebar"
     data-controller="sidebar">
  <div class="relative flex h-full max-h-full flex-col">
    <div class="flex items-center justify-between border-b border-line px-4 py-3">
      <a href="/admin" class="inline-flex max-w-full items-center overflow-hidden" aria-label="SGU UFRPE, administração">
        <span class="admin-sidebar-logo-full inline-flex items-center gap-2.5">
          <span class="grid size-9 place-items-center rounded-xl bg-brand-solid text-on-brand"><%= icon("map-pin", class: "size-5") %></span>
          <span>
            <span class="block text-base font-bold leading-none text-ink">SGU UFRPE</span>
            <span class="mt-1 block text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-muted">Administração</span>
          </span>
        </span>
        <span class="admin-sidebar-logo-mini hidden size-9 items-center justify-center rounded-lg bg-brand-solid text-on-brand">
          <%= icon("map-pin", class: "size-5") %>
        </span>
      </a>

      <div class="flex items-center gap-1">
        <button type="button"
                class="hidden size-8 items-center justify-center rounded-lg border border-line text-muted transition hover:bg-surface-muted lg:inline-flex"
                aria-haspopup="dialog"
                aria-expanded="true"
                aria-controls="hs-application-sidebar"
                aria-label="Alternar menu lateral"
                data-action="click->sidebar#toggle"
                data-sidebar-target="toggleButton">
          <svg data-sidebar-target="iconExpand" class="admin-sidebar-minifier-expand hidden size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M15 3v18"></path>
            <path d="m8 9 3 3-3 3"></path>
          </svg>
          <svg data-sidebar-target="iconCollapse" class="admin-sidebar-minifier-collapse size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M15 3v18"></path>
            <path d="m10 15-3-3 3-3"></path>
          </svg>
          <span class="sr-only">Alternar sidebar</span>
        </button>

        <button type="button"
                class="inline-flex size-8 items-center justify-center rounded-lg border border-line text-muted transition hover:bg-surface-muted lg:hidden"
                data-sidebar-mobile-toggle="true"
                aria-expanded="true"
                aria-label="Fechar menu lateral">
          <svg class="size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="h-full overflow-y-auto p-2.5 sm:p-3 [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-md [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-surface-muted/80">
      <nav class="hs-accordion-group w-full" data-hs-accordion-always-open>
        <ul class="flex flex-col space-y-1">
          <% Array(menu).each_with_index do |menu_item, index| %>
            <% next unless policy(menu_item[:policy]).menu? %>
            <% active_menu = menu_item[:active] %>
            <% item_classes = active_menu ? 'bg-surface-muted text-ink' : 'text-ink hover:bg-surface-muted' %>

            <% if menu_item.key?(:items) %>
              <% accordion_id = "sidebar-accordion-#{index}" %>
              <% child_id = menu_item[:id_collapse].presence || "#{accordion_id}-child" %>

              <li class="hs-accordion" id="<%= accordion_id %>">
                <button type="button"
                        class="admin-sidebar-item hs-accordion-toggle flex w-full items-center gap-x-3.5 rounded-lg px-2.5 py-2.5 text-start text-sm font-medium transition lg:py-2 <%= item_classes %>"
                        aria-expanded="<%= active_menu ? 'true' : 'false' %>"
                        aria-controls="<%= child_id %>">
                  <%= icon(menu_item[:icon], class: "size-4 shrink-0") %>
                  <span class="admin-sidebar-label flex-1 truncate"><%= menu_item[:name] %></span>

                  <svg class="admin-sidebar-caret hs-accordion-active:block ms-auto hidden size-4 text-muted" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m18 15-6-6-6 6"></path>
                  </svg>

                  <svg class="admin-sidebar-caret hs-accordion-active:hidden ms-auto block size-4 text-muted" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </button>

                <div id="<%= child_id %>"
                     class="admin-sidebar-submenu hs-accordion-content w-full overflow-hidden transition-[height] duration-300 <%= active_menu ? '' : 'hidden' %>"
                     role="region"
                     aria-labelledby="<%= accordion_id %>">
                  <ul class="space-y-1 ps-8 pt-1">
                    <% menu_item[:items].each do |submenu| %>
                      <% next unless policy(submenu[:policy]).menu? %>
                      <% active_submenu = submenu[:active] %>
                      <% submenu_classes = active_submenu ? 'bg-surface-muted text-ink' : 'text-ink hover:bg-surface-muted' %>

                      <li>
                        <a href="<%= url_for(submenu[:url]) %>"
                           class="admin-sidebar-subitem flex items-center gap-x-3.5 rounded-lg px-2.5 py-2.5 text-sm transition lg:py-2 <%= submenu_classes %>">
                          <%= icon(submenu[:icon], class: "size-4 shrink-0") %>
                          <span class="admin-sidebar-label truncate"><%= submenu[:name] %></span>
                        </a>
                      </li>
                    <% end %>
                  </ul>
                </div>
              </li>
            <% else %>
              <li>
                <a href="<%= url_for(menu_item[:url]) if menu_item[:url].present? %>"
                   class="admin-sidebar-item flex items-center gap-x-3.5 rounded-lg px-2.5 py-2.5 text-sm font-medium transition lg:py-2 <%= item_classes %>"
                   aria-current="<%= active_menu ? 'page' : nil %>">
                  <%= icon(menu_item[:icon], class: "size-4 shrink-0") %>
                  <span class="admin-sidebar-label truncate"><%= menu_item[:name] %></span>
                </a>
              </li>
            <% end %>
          <% end %>
        </ul>
      </nav>
    </div>
  </div>
</div>
