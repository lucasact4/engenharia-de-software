<% user_email = Current.user&.email_address.to_s %>
<% user_initial = user_email.first&.upcase || "U" %>

<div class="hs-dropdown [--placement:bottom-right] relative inline-flex">
  <button id="hs-dropdown-account"
          type="button"
          class="hs-dropdown-toggle inline-flex size-10 items-center justify-center rounded-full border border-line bg-surface text-ink transition hover:bg-surface-muted focus:outline-none"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-label="<%= t('views.application.shared.user_profile.account_menu') %>">
    <span class="text-xs font-semibold"><%= user_initial %></span>
  </button>

  <div class="hs-dropdown-menu absolute right-0 z-50 mt-2 hidden w-[min(18rem,calc(100vw-1rem))] rounded-xl border border-line bg-surface shadow-md"
       role="menu"
       aria-orientation="vertical"
       aria-labelledby="hs-dropdown-account">
    <div class="rounded-t-xl bg-surface-muted px-4 py-3">
      <p class="text-xs text-muted"><%= t("views.application.shared.user_profile.signed_as") %></p>
      <p class="truncate text-sm font-medium text-ink"><%= user_email %></p>
    </div>

    <div class="space-y-0.5 p-1.5">
      <a class="hs-dropdown-close flex items-center gap-x-2 rounded-lg px-3 py-2.5 text-sm text-ink hover:bg-surface-muted focus:outline-none"
         href="<%= panel_path %>">
        <%= icon("layout-dashboard", class: "size-4") %>
        Meu painel
      </a>

      <a class="hs-dropdown-close flex items-center gap-x-2 rounded-lg px-3 py-2.5 text-sm text-ink hover:bg-surface-muted focus:outline-none"
         href="<%= profile_path %>">
        <%= icon("user", class: "size-4") %>
        <%= t("views.application.shared.user_profile.edit_profile") %>
      </a>

      <a class="hs-dropdown-close flex items-center gap-x-2 rounded-lg px-3 py-2.5 text-sm text-ink hover:bg-surface-muted focus:outline-none"
         href="<%= publications_path %>">
        <%= icon("newspaper", class: "size-4") %>
        Mural
      </a>

      <%= link_to session_path,
        data: { turbo_method: :delete },
        class: "hs-dropdown-close flex items-center gap-x-2 rounded-lg px-3 py-2.5 text-sm text-negative-ink hover:bg-negative-soft focus:outline-none" do %>
        <%= icon("log-out", class: "size-4") %>
        <%= t("views.application.shared.user_profile.exit") %>
      <% end %>
    </div>
  </div>
</div>
