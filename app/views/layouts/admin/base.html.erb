<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
  <%= render 'layouts/admin/head' %>

  <body class="bg-surface-muted">
    <div id="admin-shell" v-cloak class="min-h-dvh bg-surface-muted">
      <%= render 'layouts/admin/navbar' %>
      <%= render 'layouts/admin/sidebar', menu: @menu %>

      <div class="admin-main-content w-full transition-all duration-300">
        <div class="min-h-[calc(100dvh-3.75rem)] p-4 sm:p-6">
          <%= render 'layouts/admin/messages' %>

          <main class="space-y-4 pt-1">
            <%= yield %>
            <%= render 'layouts/admin/footer' %>
          </main>
        </div>
      </div>
    </div>
  </body>

  <% console if Rails.env.development? %>
</html>
