<% content_for :title, "Mapa da UFRPE — Sede Recife" %>
<div class="social-feed space-y-5">
  <div>
    <p class="text-sm font-semibold text-brand-link">UFRPE · Sede Recife</p>
    <h1 class="sgu-page-title">Mapa de ocorrências</h1>
    <p class="mt-2 max-w-2xl text-sm text-muted">Veja publicações aprovadas em prédios e áreas da sede Recife e ocorrências de trânsito fora do campus. Abra um spot para consultar as publicações e o motivo informado.</p>
  </div>
  <%= render "publications/map_tabs", active: :map %>

  <section class="sgu-card overflow-hidden" data-controller="campus-map"
           data-campus-map-locations-value="<%= @map_data[:locations].to_json %>"
           data-campus-map-spots-value="<%= @map_data[:spots].to_json %>"
           data-campus-map-center-value="<%= @map_data[:center].to_json %>"
           data-campus-map-buildings-url-value="/maps/ufrpe-sede-buildings-v2.geojson">
    <p class="px-4 pt-4 text-sm text-muted" data-campus-map-target="status" role="status" aria-live="polite">Carregando o mapa da sede Recife…</p>
    <div class="h-[65vh] min-h-96 w-full" data-campus-map-target="map" aria-label="Mapa da UFRPE sede Recife com ocorrências do mural"></div>
    <p class="px-4 pb-4 text-xs text-muted">Clique em um contorno colorido para ver o nome do prédio. Os spots agrupam publicações aprovadas por local. <%= link_to "Mapa oficial da UFRPE/NTI", "https://www.nti.ufrpe.br/sites/www.nti.ufrpe.br/files/qgis/sede/index.html", target: "_blank", rel: "noopener noreferrer", class: "sgu-link" %>. Trânsito fora da sede também pode aparecer no mapa.</p>
  </section>

  <section aria-labelledby="campus_reports_title">
    <h2 id="campus_reports_title" class="sgu-section-title">Ocorrências no mapa</h2>
    <% if @map_data[:spots].any? %>
      <ul class="mt-3 space-y-3">
        <% @map_data[:spots].each do |spot| %>
          <li class="sgu-card flex flex-wrap items-center justify-between gap-3 p-4">
            <div>
              <h3 class="font-semibold text-ink"><%= spot[:count] %> publicação(ões) neste local</h3>
              <p class="mt-1 text-xs text-muted"><%= {"building" => "Prédio da sede", "location" => "Local cadastrado", "campus_area" => "Área da sede", "traffic" => "Trânsito fora da sede", "external" => "Ocorrência fora da sede"}.fetch(spot[:place_type], "Local da ocorrência") %></p>
              <ul class="mt-2 space-y-1 text-sm">
                <% spot[:publications].each do |publication| %>
                  <li>
                    <span class="font-medium"><%= publication[:title] %></span>
                    <% if publication[:category].present? %><span class="text-muted">· <%= publication[:category] %></span><% end %>
                    <%= link_to "Abrir publicação", publication[:url], class: "sgu-link ml-2" %>
                    <% if publication[:reason].present? %><p class="text-xs text-muted"><%= publication[:reason] %></p><% end %>
                  </li>
                <% end %>
              </ul>
            </div>
            <%= link_to "Abrir local no Google Maps", spot[:google_maps_url], target: "_blank", rel: "noopener noreferrer", class: "sgu-btn sgu-btn-secondary sgu-btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="sgu-empty mt-3">Ainda não há publicações aprovadas em locais da sede Recife. Os marcadores aparecerão agrupados por prédio ou local.</p>
    <% end %>
  </section>
</div>
