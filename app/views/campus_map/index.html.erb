<% content_for :title, "Mapa da UFRPE · Sede Recife" %>
<% warnings = Alert.active_public_warnings.includes(:location).limit(3).to_a %>
<div class="mural-map-page">
  <header class="mural-map-heading">
    <div><p class="mural-eyebrow">UFRPE · Sede Recife</p><h1>Mapa de ocorrências</h1></div>
    <button type="button" class="mural-filter-trigger" data-action="mural-shell#openSearch"><%= sgu_icon("search") %><%= @map_filters.any? ? "#{@map_filters.size} filtros" : "Filtrar mapa" %></button>
  </header>
  <p class="mural-map-intro">Publicações aprovadas no campus e ocorrências de trânsito. Toque em um local para ver as publicações e o motivo informado.</p>
  <%= render "publications/mural_safety_strip", warnings: warnings %>

  <section class="sgu-card overflow-hidden" data-controller="campus-map"
           data-campus-map-locations-value="<%= @map_data[:locations].to_json %>"
           data-campus-map-spots-value="<%= @map_data[:spots].to_json %>"
           data-campus-map-center-value="<%= @map_data[:center].to_json %>"
           data-campus-map-buildings-url-value="/maps/ufrpe-sede-buildings-v2.geojson">
    <p class="px-4 pt-4 text-sm text-muted" data-campus-map-target="status" role="status" aria-live="polite">Carregando o mapa da sede Recife…</p>
    <div class="h-[65vh] min-h-96 w-full" data-campus-map-target="map" aria-label="Mapa da UFRPE sede Recife com ocorrências do mural"></div>
    <p class="px-4 pb-4 text-xs text-muted">Clique em um contorno colorido para ver o nome do prédio. Pontos próximos se agrupam quando o mapa está afastado e se separam ao aproximar. <%= link_to "Mapa oficial da UFRPE/NTI", "https://www.nti.ufrpe.br/sites/www.nti.ufrpe.br/files/qgis/sede/index.html", target: "_blank", rel: "noopener noreferrer", class: "sgu-link" %>. Trânsito fora da sede também pode aparecer no mapa.</p>
  </section>

  <details class="mural-map-locations">
  <summary>Lista de ocorrências e locais</summary>
  <section class="mt-4" aria-labelledby="campus_reports_title">
    <h2 id="campus_reports_title" class="sgu-section-title">Ocorrências no mapa</h2>
    <% if @map_data[:spots].any? %>
      <ul class="mt-3 space-y-3">
        <% @map_data[:spots].each do |spot| %>
          <li class="sgu-card flex flex-wrap items-center justify-between gap-3 p-4">
            <div>
              <h3 class="font-semibold text-ink"><%= spot[:count] %> publicação(ões) neste local</h3>
              <p class="mt-1 text-xs text-muted"><%= {"building" => "Prédio da sede", "location" => "Local cadastrado", "campus_area" => "Área da sede", "traffic" => "Trânsito fora da sede", "external" => "Ocorrência fora da sede"}.fetch(spot[:place_type], "Local da ocorrência") %></p>
              <ul class="mt-2 space-y-1 text-sm">
                <% spot[:publications].each do |publication| %>
                  <li>
                    <span class="font-medium"><%= publication[:title] %></span>
                    <% if publication[:category].present? %><span class="text-muted">· <%= publication[:category] %></span><% end %>
                    <%= link_to "Abrir publicação", publication[:url], class: "sgu-link ml-2" %>
                    <% if publication[:reason].present? %><p class="text-xs text-muted"><%= publication[:reason] %></p><% end %>
                  </li>
                <% end %>
              </ul>
            </div>
            <%= link_to "Abrir local no Google Maps", spot[:google_maps_url], target: "_blank", rel: "noopener noreferrer", class: "sgu-btn sgu-btn-secondary sgu-btn-sm" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="sgu-empty mt-3">Ainda não há publicações do mural em locais da sede Recife. Os marcadores aparecerão agrupados por prédio ou local quando houver ocorrências aprovadas.</p>
    <% end %>
  </section>
  <% if @map_data[:text_locations].any? %>
    <section aria-labelledby="campus_text_locations_title">
      <h2 id="campus_text_locations_title" class="sgu-section-title">Ocorrências com local descrito</h2>
      <ul class="mt-3 space-y-3">
        <% @map_data[:text_locations].each do |entry| %>
          <li class="sgu-card p-4">
            <%= link_to entry[:title], publication_path(entry[:id]), class: "sgu-link font-semibold" %>
            <p class="mt-1 text-sm text-muted"><%= entry[:description] %></p>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  </details>
</div>
<%= render "publications/mural_search", map: true %>
