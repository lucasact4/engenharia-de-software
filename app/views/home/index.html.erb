<% content_for :title, "SGU UFRPE - Comunicação e alertas do campus" %>

<%# Exemplos desta página são demonstrativos; ela não consulta alertas nem publicações. %>
<% access_path = authenticated? ? panel_path(locale: nil) : new_session_path(locale: nil) %>
<% access_label = authenticated? ? "Abrir painel" : "Entrar" %>

<div class="min-h-dvh bg-canvas text-ink">
  <header class="sticky top-0 z-50 border-b border-line/80 bg-surface/90 backdrop-blur">
    <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10">
      <%= link_to root_path(locale: nil), class: "group flex items-center gap-3 text-ink", aria: { label: "Página inicial do SGU UFRPE" } do %>
        <span class="grid size-10 place-items-center rounded-2xl bg-brand-solid text-on-brand shadow-sm transition group-hover:bg-brand-hover">
          <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s7-4.7 7-12a7 7 0 1 0-14 0c0 7.3 7 12 7 12Z"/>
            <circle cx="12" cy="10" r="2.5"/>
          </svg>
        </span>
        <span>
          <span class="block text-lg font-bold leading-none tracking-tight">SGU UFRPE</span>
          <span class="mt-1 block text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-muted">Campus em conexão</span>
        </span>
      <% end %>

      <nav class="hidden items-center gap-8 text-sm font-semibold text-muted md:flex" aria-label="Navegação principal">
        <a href="#alertas" class="!text-muted transition hover:!text-brand-link">Alertas públicos</a>
        <%= link_to "Mural", publications_path(locale: nil), class: "!text-muted transition hover:!text-brand-link" %>
        <a href="#como-funciona" class="!text-muted transition hover:!text-brand-link">Como funciona</a>
        <a href="#sobre" class="!text-muted transition hover:!text-brand-link">Sobre o SGU</a>
      </nav>

      <div class="flex items-center gap-2">
        <%= render "shared/theme_toggle" %>
        <% unless authenticated? %><%= link_to "Criar conta", new_registration_path(locale: nil), class: "sgu-btn sgu-btn-secondary hidden sm:inline-flex" %><% end %>
      <%= link_to access_path,
        class: "inline-flex h-10 items-center justify-center gap-2 rounded-full bg-brand-solid px-5 text-sm font-bold !text-on-brand shadow-sm transition hover:bg-brand-hover hover:!text-on-brand focus:outline-none focus:ring-2 focus:ring-brand-link/30" do %>
        <%= access_label %>
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      <% end %>
      </div>
    </div>
  </header>

  <main>
    <section class="relative isolate overflow-hidden bg-canvas">
      <div class="absolute inset-x-0 top-0 -z-10 h-[36rem] bg-[radial-gradient(circle_at_80%_15%,rgba(36,136,120,0.18),transparent_34%),radial-gradient(circle_at_10%_80%,rgba(232,176,72,0.16),transparent_30%)]"></div>
      <div class="mx-auto grid max-w-7xl gap-14 px-5 py-16 sm:px-8 sm:py-24 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:px-10 lg:py-28">
        <div class="max-w-3xl">
          <div class="inline-flex items-center gap-2 rounded-full border border-positive-line bg-surface/70 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-brand-link shadow-sm">
            <span class="size-2 rounded-full bg-accent"></span>
            Informação que cuida do campus
          </div>

          <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-[-0.04em] text-ink sm:text-5xl lg:text-6xl">
            Uma UFRPE mais segura começa com informação compartilhada.
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted">
            Acompanhe alertas públicos, comunique problemas de infraestrutura e ajude a construir um campus mais seguro, acessível e sustentável.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="<%= publications_path(locale: nil) %>" class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-brand-solid px-6 text-sm font-bold !text-on-brand shadow-lg shadow-brand-solid/15 transition hover:-translate-y-0.5 hover:bg-brand-hover hover:!text-on-brand">
              Ver o mural do campus
              <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
            <%= link_to "Criar minha conta", new_registration_path(locale: nil), class: "inline-flex h-12 items-center justify-center rounded-full border border-line bg-surface px-6 text-sm font-bold !text-ink transition hover:border-brand-link hover:!text-brand-link" %>
          </div>

          <div class="mt-9 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-muted">
            <span class="inline-flex items-center gap-2"><span class="grid size-5 place-items-center rounded-full bg-positive-soft text-positive-ink">✓</span> Acesso público aos alertas</span>
            <span class="inline-flex items-center gap-2"><span class="grid size-5 place-items-center rounded-full bg-positive-soft text-positive-ink">✓</span> Acompanhamento transparente</span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-lg lg:mx-0 lg:justify-self-end">
          <div class="absolute -inset-5 -z-10 rounded-[2.5rem] bg-brand-solid/10 blur-2xl"></div>
          <div class="overflow-hidden rounded-[2rem] border border-line/80 bg-surface shadow-2xl shadow-slate-900/10">
            <div class="flex items-center justify-between border-b border-line px-6 py-5">
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-link">Visão pública</p>
                <h2 class="mt-1 text-lg font-bold text-ink">Situação do campus</h2>
              </div>
              <span class="inline-flex items-center gap-2 rounded-full bg-positive-soft px-3 py-1.5 text-xs font-bold text-positive-ink">
                <span class="size-2 animate-pulse rounded-full bg-positive-ink"></span> Atualizado
              </span>
            </div>

            <div class="space-y-3 p-4 sm:p-6">
              <article class="rounded-2xl border border-warning-line bg-warning-soft/70 p-4">
                <div class="flex items-start gap-3">
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-warning-soft text-warning-ink">
                    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M8.5 14.5A6 6 0 1 1 15.5 14.5L14 16H10l-1.5-1.5Z"/></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-bold text-ink">Iluminação</h3>
                      <span class="rounded-full bg-warning-soft/70 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-warning-ink">Em análise</span>
                    </div>
                    <p class="mt-1 text-sm leading-6 text-muted">Verificação preventiva em área de circulação noturna.</p>
                  </div>
                </div>
              </article>

              <article class="rounded-2xl border border-info-line bg-info-soft/70 p-4">
                <div class="flex items-start gap-3">
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-info-soft text-info-ink">
                    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2"/><path d="M9 22v-5l-2-3 2-4 3 2 3-2 2 3M12 12v5l3 5M12 17l-3 5"/></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-bold text-ink">Acessibilidade</h3>
                      <span class="rounded-full bg-info-soft/70 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-info-ink">Recebido</span>
                    </div>
                    <p class="mt-1 text-sm leading-6 text-muted">Solicitação de avaliação em rota acessível do campus.</p>
                  </div>
                </div>
              </article>

              <article class="rounded-2xl border border-positive-line bg-positive-soft/70 p-4">
                <div class="flex items-start gap-3">
                  <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-positive-soft text-positive-ink">
                    <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z"/><path d="m9 12 2 2 4-4"/></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <h3 class="font-bold text-ink">Segurança</h3>
                      <span class="rounded-full bg-positive-soft/70 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-positive-ink">Resolvido</span>
                    </div>
                    <p class="mt-1 text-sm leading-6 text-muted">Atualização concluída pela equipe responsável.</p>
                  </div>
                </div>
              </article>
            </div>

            <p class="border-t border-line bg-surface-muted px-6 py-3 text-center text-xs text-muted">Conteúdo demonstrativo da futura área de alertas públicos.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="alertas" class="border-y border-line bg-surface py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-link">Alertas públicos</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Informação útil, aberta para toda a comunidade.</h2>
          <p class="mt-4 text-lg leading-8 text-muted">O portal público será o ponto de encontro para avisos, atualizações e orientações que impactam a rotina no campus.</p>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          <% [
            ["Infraestrutura", "Iluminação, calçadas, vazamentos e condições dos prédios em um só fluxo de acompanhamento.", "#fff7e6", "#9a5b00"],
            ["Mobilidade e acesso", "Informações que ajudam a comunidade a circular pelo campus com mais autonomia e segurança.", "#eaf6f3", "#176355"],
            ["Segurança do campus", "Comunicados preventivos e orientações claras para situações que exigem atenção da comunidade.", "#eef3fa", "#315984"]
          ].each_with_index do |(title, description, background, color), index| %>
            <article class="rounded-3xl border border-line p-6 transition hover:-translate-y-1 hover:shadow-lg hover:shadow-slate-900/5">
              <span class="grid size-11 place-items-center rounded-2xl text-sm font-extrabold" style="background-color: <%= background %>; color: <%= color %>"><%= index + 1 %></span>
              <h3 class="mt-5 text-xl font-bold text-ink"><%= title %></h3>
              <p class="mt-3 leading-7 text-muted"><%= description %></p>
            </article>
          <% end %>
        </div>
      </div>
    </section>

    <section id="como-funciona" class="py-20 sm:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-10">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div class="lg:sticky lg:top-28">
            <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-link">Como funciona</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">Da observação à solução, com transparência.</h2>
            <p class="mt-4 text-lg leading-8 text-muted">O SGU aproxima a comunidade acadêmica das equipes responsáveis pelo cuidado do campus.</p>
          </div>

          <ol class="space-y-4">
            <% [
              ["01", "Comunique", "Usuários identificados registram uma ocorrência com categoria, foto e localização aproximada."],
              ["02", "Acompanhe", "Cada demanda apresenta um status claro: recebida, em análise ou resolvida."],
              ["03", "Compartilhe", "Atualizações de interesse coletivo ficam disponíveis no portal público para toda a comunidade."]
            ].each do |number, title, description| %>
              <li class="grid gap-4 rounded-3xl border border-line bg-surface p-6 shadow-sm sm:grid-cols-[4rem_1fr] sm:items-start">
                <span class="text-2xl font-black tracking-tight text-warning-ink"><%= number %></span>
                <div>
                  <h3 class="text-xl font-bold text-ink"><%= title %></h3>
                  <p class="mt-2 leading-7 text-muted"><%= description %></p>
                </div>
              </li>
            <% end %>
          </ol>
        </div>
      </div>
    </section>

    <section id="sobre" class="bg-brand-solid py-20 text-on-brand sm:py-24">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[1fr_auto] lg:items-center lg:px-10">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-accent">Sobre o projeto</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Tecnologia a serviço da cidadania acadêmica.</h2>
          <p class="mt-5 text-lg leading-8 text-emerald-50/80">O SGU é uma proposta de gestão urbana colaborativa para conectar estudantes, professores, funcionários, equipes de segurança e visitantes no cuidado diário com a UFRPE.</p>
        </div>
        <%= link_to "Acessar o SGU", access_path, class: "inline-flex h-12 items-center justify-center rounded-full bg-accent px-7 text-sm font-bold !text-on-accent transition hover:bg-accent-hover hover:!text-on-accent" %>
      </div>
    </section>
  </main>

  <footer class="bg-brand-hover text-emerald-50/75">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-8 sm:px-8 md:flex-row md:items-center md:justify-between lg:px-10">
      <div class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-xl bg-surface/10 text-on-brand">
          <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-4.7 7-12a7 7 0 1 0-14 0c0 7.3 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </span>
        <div>
          <p class="font-bold text-on-brand">SGU UFRPE</p>
          <p class="text-xs">Sistema de Comunicação e Alertas</p>
        </div>
      </div>
      <p class="text-sm">Equipe UFRPE de Engenharia de Software</p>
    </div>
  </footer>
</div>
