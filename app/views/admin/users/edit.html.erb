<% content_for :title, "Editar #{@instance.email_address}" %>
<div class="mx-auto max-w-3xl space-y-5 py-2">
  <%= render "admin/shared/page_header", back: admin_user_path(@instance), back_label: "Conta", eyebrow: "Usuário", title: @instance.email_address %>

  <%= form_with model: @instance, scope: :user, url: admin_user_path(@instance), method: :patch, class: "edit_user space-y-5", html: { novalidate: true } do |f| %>
    <% if @instance.errors.any? %>
      <div class="rounded-xl border border-negative-line bg-negative-soft p-4 text-sm text-negative-ink" role="alert">
        <ul class="list-disc space-y-1 pl-5"><% @instance.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <fieldset class="sgu-card space-y-4 p-5 sm:p-6">
      <legend class="sr-only">Conta</legend>
      <h2 class="sgu-section-title">Conta</h2>
      <div>
        <%= f.label :email_address, attribute_translation(model_singular_name_to_translate(@instance), :email_address), class: "sgu-label" %>
        <%= f.email_field :email_address, class: "sgu-input", id: model_field_id(@instance, :email_address) %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :password, attribute_translation(model_singular_name_to_translate(@instance), :password), class: "sgu-label" %>
          <%= f.password_field :password, class: "sgu-input", id: model_field_id(@instance, :password), autocomplete: "new-password", placeholder: translate_view_edit("password_placeholder") %>
        </div>
        <div>
          <%= f.label :password_confirmation, attribute_translation(model_singular_name_to_translate(@instance), :password_confirmation), class: "sgu-label" %>
          <%= f.password_field :password_confirmation, class: "sgu-input", id: model_field_id(@instance, :password_confirmation), autocomplete: "new-password", placeholder: translate_view_edit("password_confirmation_placeholder") %>
        </div>
      </div>
      <p class="sgu-hint"><%= translate_view_edit("password_hint") %></p>
      <p class="sgu-hint">Ao trocar a senha, use pelo menos 8 caracteres, maiúscula, minúscula, número e símbolo (até 72 bytes).</p>
    </fieldset>

    <fieldset class="sgu-card space-y-4 p-5 sm:p-6">
      <legend class="sr-only">Perfil</legend>
      <h2 class="sgu-section-title">Perfil</h2>
      <%= render "shared/profile_fields", f: f, user: @instance, admin_editing: true %>
      <div>
        <%= label_tag :profile_reason, "Motivo da alteração de perfil (opcional, vai para o histórico)", class: "sgu-label" %>
        <%= text_field_tag :profile_reason, params[:profile_reason], class: "sgu-input", maxlength: 1000 %>
      </div>
    </fieldset>

    <fieldset class="sgu-card space-y-4 p-5 sm:p-6">
      <legend class="sr-only">Dados para pesquisa de pessoas</legend>
      <h2 class="sgu-section-title">Dados para pesquisa de pessoas</h2>
      <p class="sgu-hint">Apenas administradores podem consultar estes dados. CPF, CNPJ e telefone são armazenados criptografados.</p>
      <div>
        <%= f.label :person_type, "Tipo de pessoa", class: "sgu-label" %>
        <%= f.select :person_type, [["Pessoa física", "natural"], ["Pessoa jurídica", "legal"]], {}, class: "sgu-input" %>
      </div>
      <div>
        <%= f.label :business_name, "Razão social", class: "sgu-label" %>
        <%= f.text_field :business_name, class: "sgu-input", autocomplete: "off", maxlength: 160 %>
      </div>
      <div>
        <%= f.label :mother_name, "Nome da mãe", class: "sgu-label" %>
        <%= f.text_field :mother_name, class: "sgu-input", autocomplete: "off", maxlength: 160 %>
      </div>
      <div>
        <%= f.label :phone, "Telefone", class: "sgu-label" %>
        <%= f.telephone_field :phone, class: "sgu-input", inputmode: "tel", autocomplete: "off", maxlength: 18 %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :cpf, "CPF", class: "sgu-label" %>
          <%= f.text_field :cpf, class: "sgu-input", inputmode: "numeric", autocomplete: "off", maxlength: 14 %>
        </div>
        <div>
          <%= f.label :cnpj, "CNPJ", class: "sgu-label" %>
          <%= f.text_field :cnpj, class: "sgu-input", inputmode: "numeric", autocomplete: "off", maxlength: 18 %>
        </div>
      </div>
    </fieldset>

    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", admin_user_path(@instance), class: "sgu-btn sgu-btn-secondary" %>
      <%= f.button "Salvar", type: "submit", class: "sgu-btn sgu-btn-primary" %>
    </div>
  <% end %>
</div>
