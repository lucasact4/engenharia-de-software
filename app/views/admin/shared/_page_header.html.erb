<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div class="min-w-0">
    <% if local_assigns[:back] %>
      <%= link_to back, class: "mb-3 inline-flex items-center gap-1 text-sm font-semibold !text-muted hover:!text-brand-link" do %><%= sgu_icon("chevron-left") %> <%= local_assigns.fetch(:back_label, "Voltar") %><% end %>
    <% end %>
    <% if local_assigns[:eyebrow] %><p class="sgu-eyebrow"><%= eyebrow %></p><% end %>
    <h1 class="sgu-page-title mt-1 break-words"><%= title %></h1>
    <% if local_assigns[:description] %><p class="mt-2 max-w-3xl text-sm text-muted"><%= description %></p><% end %>
  </div>
  <div class="flex shrink-0 flex-wrap gap-2"><%= yield %></div>
</div>
