<% active = @instances.find(&:active?) %>
<div class="w-full py-4 sm:py-6 lg:py-8">
  <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-sm">
    <div class="flex flex-col gap-4 border-b border-line px-4 py-4 sm:px-6 sm:py-5 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h1 class="text-2xl font-semibold text-ink sm:text-3xl">Apresentação</h1>
        <p class="mt-1 max-w-3xl text-sm text-muted">
          Perfis escolhem quais slides e conteúdos aparecem em <%= link_to "/apresentacao", presentation_path(locale: nil), class: "font-medium text-brand-link underline", target: "_blank", rel: "noopener" %>.
          Todos usam o mesmo conteúdo de <code>config/presentation/</code>; o perfil guarda só a seleção.
        </p>
      </div>

      <%= link_to new_admin_presentation_profile_path, class: "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-solid px-5 py-2.5 text-sm font-medium text-on-brand transition hover:bg-brand-hover sm:w-auto" do %>
        <%= icon("plus", class: "size-4") %>
        Novo perfil
      <% end %>
    </div>

    <div class="border-b border-line bg-surface-muted px-4 py-3 text-sm text-ink sm:px-6" role="status">
      <% if active %>
        Perfil padrão da apresentação pública: <strong class="text-ink"><%= active.name %></strong>
      <% else %>
        Nenhum perfil padrão: a apresentação pública usa a seleção padrão do roteiro (<code>config/presentation/roteiro.yml</code>).
      <% end %>
    </div>

    <% if @instances.any? %>
      <ul class="divide-y divide-line" role="list">
        <% @instances.each do |profile| %>
          <% selection = profile.selection(@presentation) %>
          <li id="presentation_profile_<%= profile.id %>" class="flex flex-col gap-3 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="min-w-0 space-y-1">
              <p class="flex flex-wrap items-center gap-2">
                <%= link_to profile.name, edit_admin_presentation_profile_path(profile), class: "text-base font-semibold text-brand-link hover:text-brand-link" %>
                <% if profile.active? %>
                  <span class="inline-flex items-center rounded-full border border-positive-line bg-positive-soft px-2.5 py-0.5 text-xs font-semibold text-positive-ink">Padrão da apresentação pública</span>
                <% end %>
              </p>
              <p class="text-sm text-muted">
                <%= selection.delivery[:titulo] %> ·
                <%= selection.visible_main_slides.size %> slides principais, <%= selection.visible_appendix_slides.size %> apêndices ·
                <span class="<%= selection.over_limit? ? 'font-semibold text-negative-ink' : '' %>"><%= presentation_estimate_text(selection) %></span>
              </p>
              <% if profile.description.present? %><p class="text-sm text-muted"><%= profile.description %></p><% end %>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <%= link_to "Editar seleção", edit_admin_presentation_profile_path(profile), class: "btn-secondary" %>
              <%= link_to presentation_path(locale: nil, perfil: profile.id), class: "btn-secondary", target: "_blank", rel: "noopener" do %>
                Visualizar<span class="sr-only"> <%= profile.name %> (abre em nova aba)</span>
              <% end %>
              <% unless profile.active? %>
                <%= button_to "Usar como padrão", activate_admin_presentation_profile_path(profile), method: :patch, class: "btn-primary" %>
                <%= button_to "Excluir", admin_presentation_profile_path(profile), method: :delete, class: "btn-secondary text-negative-ink",
                      form: { data: { turbo_confirm: "Excluir o perfil “#{profile.name}”? O conteúdo da apresentação não é afetado." } } %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="mx-auto flex min-h-[16rem] w-full max-w-md flex-col justify-center px-4 py-8 sm:px-6">
        <h2 class="text-lg font-semibold text-ink">Nenhum perfil cadastrado</h2>
        <p class="mt-2 text-sm text-muted">
          A apresentação pública continua funcionando com a seleção padrão do roteiro. Crie um perfil para escolher slides por entrega,
          ou rode <code>bin/rails db:seed</code> para criar os perfis da primeira e da segunda entrega.
        </p>
      </div>
    <% end %>
  </div>
</div>
