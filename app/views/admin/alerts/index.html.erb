<% content_for :title, "Ocorrências" %>
<div class="space-y-5 py-2">
  <%= render layout: "admin/shared/page_header", locals: { eyebrow: "Atendimento", title: "Ocorrências e pânicos", description: "Lista completa para a administração. Nada é excluído: registros são encerrados com motivo e continuam no histórico." } do %>
    <%= link_to new_admin_alert_path, class: "sgu-btn sgu-btn-primary" do %><%= sgu_icon("plus") %> Registrar ocorrência<% end %>
  <% end %>

  <%= render "shared/alerts/filters", url: admin_alerts_path, filter_options: @filter_options, assignees: @assignees %>

  <% if @alerts.any? %>
    <div class="sgu-card overflow-hidden">
      <ul class="divide-y divide-line md:hidden">
        <% @alerts.each do |alert| %>
          <li class="p-4">
            <%= link_to admin_alert_path(alert), class: "block !text-ink" do %>
              <p class="font-mono text-xs text-muted"><%= alert.protocol %> · <%= sgu_time(alert.created_at) %></p>
              <p class="mt-1 font-semibold"><%= alert.title.presence || "Pedido de pânico" %></p>
            <% end %>
            <div class="mt-2 flex flex-wrap gap-1.5"><%= alert_status_badge(alert) %><%= alert_priority_badge(alert) %></div>
          </li>
        <% end %>
      </ul>
      <div class="hidden overflow-x-auto md:block">
        <table class="min-w-full divide-y divide-line text-sm">
          <thead class="bg-surface-muted text-left text-xs font-semibold uppercase tracking-wide text-muted">
            <tr>
              <th scope="col" class="px-4 py-3">Protocolo</th>
              <th scope="col" class="px-4 py-3">Registro</th>
              <th scope="col" class="px-4 py-3">Situação</th>
              <th scope="col" class="px-4 py-3">Prioridade</th>
              <th scope="col" class="px-4 py-3">Responsável</th>
              <th scope="col" class="px-4 py-3">Registrado em</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @alerts.each do |alert| %>
              <tr class="hover:bg-surface-muted" id="admin_alert_<%= alert.id %>">
                <td class="whitespace-nowrap px-4 py-3 font-mono"><%= link_to alert.protocol, admin_alert_path(alert), class: "sgu-link" %></td>
                <td class="px-4 py-3">
                  <p class="font-semibold text-ink"><% if alert.panic? %><span class="text-negative-ink"><%= sgu_icon("siren", "inline size-4 align-text-bottom") %></span> Pânico<% else %><%= alert.title %><% end %></p>
                  <p class="text-xs text-muted"><%= alert.category&.name %><% if alert.location %> · <%= alert.location.name %><% end %></p>
                </td>
                <td class="px-4 py-3"><%= alert_status_badge(alert) %></td>
                <td class="px-4 py-3"><%= alert_priority_badge(alert) %></td>
                <td class="px-4 py-3 text-ink"><%= alert.assigned_to ? (alert.assigned_to.display_name.presence || alert.assigned_to.email_address) : "—" %></td>
                <td class="whitespace-nowrap px-4 py-3 text-muted"><%= sgu_time(alert.created_at) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="sgu-empty">
      <p class="font-semibold text-ink">Nenhum alerta encontrado.</p>
      <p class="mt-1 text-sm text-muted">Ajuste os filtros ou <%= link_to "limpe a busca", admin_alerts_path, class: "sgu-link" %>.</p>
    </div>
  <% end %>
</div>
