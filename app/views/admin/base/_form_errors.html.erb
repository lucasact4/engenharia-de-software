<% if @instance.errors.any? %>
  <% error_id = "form_errors_#{@instance.class.name.underscore}_#{@instance.id || 'new'}" %>
  <div id="<%= error_id %>" class="mt-2 flex items-start justify-between gap-2 rounded-xl border border-negative-line bg-negative-soft px-4 py-3 text-sm text-negative-ink" role="alert">
    <ul class="list-disc pl-5">
      <% @instance.errors.each do |item| %>
        <li><strong><%= item.attribute %>: </strong><%= item.message %></li>
      <% end %>
    </ul>
    <button type="button" class="flash-close" data-hs-remove-element="#<%= error_id %>">
      <%= icon("x", class: "size-3") %>
    </button>
  </div>
<% end %>
