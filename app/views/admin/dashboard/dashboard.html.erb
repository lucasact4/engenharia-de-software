<% content_for :title, "Administração" %>
<div class="space-y-6 py-2">
  <section class="overflow-hidden rounded-2xl bg-brand-solid p-6 text-on-brand sm:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent">SGU UFRPE · Administração</p>
    <h1 class="mt-2 text-2xl font-bold sm:text-3xl">Olá, <%= Current.user.display_name.presence || Current.user.email_address %>.</h1>
    <p class="mt-2 max-w-2xl text-emerald-50/80">Atendimento de ocorrências, revisão editorial, moderação e catálogos.</p>
  </section>

  <section aria-labelledby="dashboard_queue">
    <h2 id="dashboard_queue" class="sgu-section-title">Pede ação</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% [ [ "Alertas em aberto", @counts[:open_alerts], admin_alerts_path ],
           [ "Pânicos em aberto", @counts[:open_panics], admin_alerts_path(kind: "panic") ],
           [ "Sem responsável", @counts[:unassigned], admin_alerts_path(assigned: "none") ],
           [ "Publicações em revisão", @counts[:pending_reviews], admin_publications_path(review: "pending") ],
           [ "Ocorrências pendentes", @counts[:source_review], admin_publications_path(source_review: "1") ],
           [ "Denúncias pendentes", @counts[:pending_reports], admin_content_reports_path ] ].each do |label, value, path| %>
        <%= link_to path, class: "sgu-card block p-4 !text-ink hover:border-brand-link" do %>
          <p class="text-xs font-semibold text-muted"><%= label %></p>
          <p class="mt-1 text-3xl font-bold <%= label.start_with?('Pânico') && value.positive? ? 'text-negative-ink' : '' %>"><%= value %></p>
        <% end %>
      <% end %>
    </div>
  </section>

  <section class="sgu-card p-5 sm:p-6" aria-labelledby="dashboard_catalogs">
    <h2 id="dashboard_catalogs" class="sgu-section-title">Catálogos</h2>
    <dl class="sgu-dl mt-4">
      <dt>Categorias ativas</dt><dd><%= link_to @counts[:active_categories], admin_categories_path, class: "sgu-link" %></dd>
      <dt>Locais ativos</dt>
      <dd>
        <%= link_to @counts[:active_locations], admin_locations_path, class: "sgu-link" %>
        <% if @counts[:active_locations].zero? %><span class="ml-2 text-warning-ink">Pendente: lista oficial de locais da UFRPE ainda não cadastrada.</span><% end %>
      </dd>
    </dl>
  </section>
</div>
