<% content_for :title, "Locais" %>
<%= render layout: "admin/catalogs/index", locals: {
      title: "Locais do campus", description: "Usados na seleção manual de localização. Coordenadas de referência descrevem o local e nunca substituem o GPS de um relato.",
      new_label: "Novo local", new_path: new_admin_location_path, index_path: admin_locations_path,
      edit_path: ->(entry) { edit_admin_location_path(entry) }, activate_path: ->(entry) { activate_admin_location_path(entry) },
      deactivate_path: ->(entry) { deactivate_admin_location_path(entry) }, instances: @instances, usage: @usage,
      empty_title: "Nenhum local cadastrado ainda.",
      empty_description: "A lista oficial de prédios e áreas da UFRPE ainda não foi fornecida. Cadastre aqui os locais reais quando estiverem disponíveis; não use pontos inventados. Enquanto isso, use GPS, ponto no mapa ou descrição do local." } do %>
  <% unless Location.active.exists? %>
    <p class="rounded-xl border border-warning-line bg-warning-soft p-4 text-sm text-warning-ink" role="status">
      O catálogo é opcional. GPS, seleção no mapa e descrição do local continuam disponíveis para registrar ocorrências.
    </p>
  <% end %>
<% end %>
