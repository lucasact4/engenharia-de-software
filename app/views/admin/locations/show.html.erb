<% content_for :title, @instance.name %>
<div class="mx-auto max-w-3xl space-y-5 py-2">
  <%= render layout: "admin/shared/page_header", locals: { back: admin_locations_path, back_label: "Locais", eyebrow: "Local", title: @instance.name } do %>
    <%= link_to "Editar", edit_admin_location_path(@instance), class: "sgu-btn sgu-btn-secondary" %>
  <% end %>
  <dl class="sgu-card sgu-dl p-5">
    <dt>Código</dt><dd class="font-mono"><%= @instance.code %></dd>
    <dt>Descrição</dt><dd><%= @instance.description.presence || "—" %></dd>
    <dt>Referência</dt><dd><%= @instance.reference_latitude ? "#{@instance.reference_latitude}, #{@instance.reference_longitude}" : "—" %></dd>
    <dt>Situação</dt><dd><%= @instance.active? ? "Ativo" : "Inativo" %></dd>
    <dt>Alertas</dt><dd><%= @instance.alerts.count %></dd>
  </dl>
</div>
