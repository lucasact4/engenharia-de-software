      title: "Categorias", description: "Assunto das ocorrências. Uma ocorrência tem uma única categoria.",
      new_label: "Nova categoria", new_path: new_admin_category_path, index_path: admin_categories_path,
      edit_path: ->(entry) { edit_admin_category_path(entry) }, activate_path: ->(entry) { activate_admin_category_path(entry) },
      deactivate_path: ->(entry) { deactivate_admin_category_path(entry) }, instances: @instances, usage: @usage,
      empty_title: "Nenhuma categoria cadastrada.",
      empty_description: "Rode bin/rails sgu:catalogs:bootstrap para criar as categorias essenciais ou cadastre uma nova." } do %>
<% end %>
