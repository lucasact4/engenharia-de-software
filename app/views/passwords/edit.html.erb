<% content_for :title, "Redefinir senha · SGU UFRPE" %>
<%= render layout: "shared/auth/shell", locals: { eyebrow: "Proteja sua conta", title: "Defina uma nova senha", description: "Escolha uma senha que cumpra todos os requisitos abaixo." } do %>
  <% if @user.errors.any? %><div class="mb-5 rounded-xl border border-negative-line bg-negative-soft p-4 text-sm text-negative-ink" role="alert"><ul class="list-disc pl-5"><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-5" do |form| %>
    <%= render "shared/auth/password_fields", form: form %>
    <%= form.submit "Redefinir senha", class: "sgu-btn sgu-btn-primary h-12 w-full" %>
  <% end %>
<% end %>
