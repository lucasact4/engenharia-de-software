<% content_for :title, "Recuperar senha · SGU UFRPE" %>
<%= render layout: "shared/auth/shell", locals: { eyebrow: "Recupere seu acesso", title: "Esqueceu sua senha?", description: "Informe seu e-mail para receber as instruções de recuperação." } do %>
  <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
    <div><%= form.label :email_address, "E-mail", class: "sgu-label" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "sgu-input", placeholder: "seuemail@ufrpe.br", value: params[:email_address] %></div>
    <%= form.submit "Enviar instruções", class: "sgu-btn sgu-btn-primary h-12 w-full" %>
  <% end %>
  <p class="mt-6 text-center text-sm text-muted"><%= link_to "Voltar para entrar", new_session_path(locale: nil), class: "sgu-link" %></p>
<% end %>
