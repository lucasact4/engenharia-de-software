<% content_for :title, "Entrar - SIS UFRPE" %>

<div class="grid min-h-dvh bg-[#f4f7f5] lg:grid-cols-[0.92fr_1.08fr]">
  <section class="flex min-h-dvh flex-col bg-white px-5 py-6 sm:px-10 lg:px-14">
    <%= link_to root_path(locale: nil), class: "flex w-fit items-center gap-3 !text-slate-900", aria: { label: "Voltar para a página inicial" } do %>
      <span class="grid size-10 place-items-center rounded-2xl bg-[#153c36] text-white">
        <svg aria-hidden="true" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-4.7 7-12a7 7 0 1 0-14 0c0 7.3 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg>
      </span>
      <span>
        <span class="block text-lg font-bold leading-none">SIS UFRPE</span>
        <span class="mt-1 block text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-slate-500">Campus em conexão</span>
      </span>
    <% end %>

    <div class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center py-12">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-[#277d6e]">Área identificada</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">Entre na sua conta</h1>
        <p class="mt-3 leading-7 text-slate-600">Acesse o painel para registrar e acompanhar ocorrências do campus.</p>
      </div>

      <div class="mt-8">
        <%= render "partials/messages" %>

        <%= form_with url: session_path(locale: nil), class: "mt-5 space-y-5" do |form| %>
          <div>
            <label for="email_address" class="mb-2 block text-sm font-bold text-slate-700">E-mail</label>
            <%= form.email_field :email_address,
              id: "email_address",
              class: "block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#277d6e] focus:ring-4 focus:ring-[#277d6e]/10",
              required: true,
              autofocus: true,
              autocomplete: "username",
              placeholder: "seuemail@ufrpe.br",
              value: params[:email_address] %>
          </div>

          <div data-controller="password-toggle">
            <div class="mb-2 flex items-center justify-between gap-2">
              <label for="password" class="block text-sm font-bold text-slate-700">Senha</label>
              <%= link_to "Esqueci minha senha", new_password_path, class: "text-xs font-bold !text-[#277d6e] hover:underline" %>
            </div>

            <div class="relative">
              <%= form.password_field :password,
                id: "password",
                class: "block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 pr-12 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-[#277d6e] focus:ring-4 focus:ring-[#277d6e]/10",
                data: { password_toggle_target: "input" },
                spellcheck: false,
                autocorrect: :off,
                autocapitalize: :off,
                required: true,
                autocomplete: "current-password",
                placeholder: "Digite sua senha",
                maxlength: 72 %>

              <button type="button"
                      class="absolute inset-y-0 right-0 inline-flex items-center justify-center px-4 text-slate-500 transition hover:text-slate-800"
                      data-action="password-toggle#toggle"
                      aria-label="Mostrar senha">
                <span data-password-toggle-target="showIcon"><%= icon("eye", class: "size-5") %></span>
                <span class="hidden" data-password-toggle-target="hideIcon"><%= icon("eye-off", class: "size-5") %></span>
              </button>
            </div>
          </div>

          <%= form.submit "Entrar",
            class: "inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-xl bg-[#153c36] px-5 text-sm font-bold text-white shadow-lg shadow-[#153c36]/15 transition hover:bg-[#0f2f2a] focus:outline-none focus:ring-4 focus:ring-[#153c36]/20" %>
        <% end %>

        <% if Rails.env.development? %>
          <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-950">
            <p class="font-bold">Acesso de desenvolvimento</p>
            <p class="mt-1 font-mono text-xs sm:text-sm">dev@dev.com <span class="text-amber-500">/</span> test@123</p>
          </div>
        <% end %>
      </div>

      <%= link_to root_path(locale: nil), class: "mt-8 inline-flex w-fit items-center gap-2 text-sm font-bold !text-slate-600 hover:!text-[#153c36]" do %>
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        Voltar para a página inicial
      <% end %>
    </div>
  </section>

  <aside class="relative hidden overflow-hidden bg-[#153c36] lg:block" aria-label="Apresentação do SIS">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(242,189,87,0.22),transparent_30%),radial-gradient(circle_at_20%_80%,rgba(65,170,149,0.24),transparent_34%)]"></div>
    <div class="relative flex h-full flex-col justify-between p-14 text-white xl:p-20">
      <p class="max-w-sm text-sm font-bold uppercase tracking-[0.18em] text-[#f2bd57]">Comunicação e alertas da UFRPE</p>
      <blockquote class="max-w-2xl">
        <p class="text-4xl font-bold leading-tight tracking-tight xl:text-5xl">Cuidar do campus é uma construção coletiva.</p>
        <footer class="mt-6 max-w-xl text-lg leading-8 text-emerald-50/75">Registre situações, acompanhe respostas e participe de uma comunidade mais segura, acessível e sustentável.</footer>
      </blockquote>
      <div class="flex items-center gap-3 text-sm text-emerald-50/70">
        <span class="h-px w-10 bg-[#f2bd57]"></span>
        Projeto acadêmico de Engenharia de Software
      </div>
    </div>
  </aside>
</div>
