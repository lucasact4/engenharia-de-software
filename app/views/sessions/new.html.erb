<% content_for :title, "Entrar · SGU UFRPE" %>
<%= render layout: "shared/auth/shell", locals: { eyebrow: "Sua comunidade espera por você", title: "Entre na sua conta", description: "Acesse notícias, acompanhe seus alertas e participe das conversas do campus." } do %>
  <%= form_with url: session_path(locale: nil), class: "space-y-5" do |form| %>
    <div><%= form.label :email_address, "E-mail", class: "sgu-label" %><%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "sgu-input h-12", placeholder: "seuemail@ufrpe.br", value: params[:email_address] %></div>
    <div data-controller="password-toggle">
      <div class="mb-2 flex items-center justify-between gap-2"><%= form.label :password, "Senha", class: "sgu-label !mb-0" %><%= link_to "Esqueci minha senha", new_password_path, class: "sgu-link text-xs" %></div>
      <div class="relative">
        <%= form.password_field :password, required: true, maxlength: 72, autocomplete: "current-password", class: "sgu-input h-12 pr-12", data: { password_toggle_target: "input" }, placeholder: "Digite sua senha" %>
        <button type="button" class="absolute inset-y-0 right-0 px-4 text-muted" data-action="password-toggle#toggle" aria-label="Mostrar senha"><span data-password-toggle-target="showIcon"><%= icon("eye", class: "size-5", "aria-hidden": true) %></span><span class="hidden" data-password-toggle-target="hideIcon"><%= icon("eye-off", class: "size-5", "aria-hidden": true) %></span></button>
      </div>
    </div>
    <%= form.submit "Entrar", class: "sgu-btn sgu-btn-primary h-12 w-full" %>
  <% end %>
  <p class="mt-6 text-center text-sm text-muted">Ainda não tem conta? <%= link_to "Criar conta", new_registration_path(locale: nil), class: "sgu-link" %></p>
  <div class="mt-6"><%= render "shared/auth/development_notice" %></div>
<% end %>
