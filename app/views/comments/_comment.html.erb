<%# Comentário projetado (CommentProjection). Ocultos viram marcador sem texto nem autoria. %>
<% dom_id = "comment_#{comment[:id]}" %>
<article id="<%= dom_id %>" class="rounded-xl border border-line bg-surface p-4 <%= comment[:parent_id] ? 'ml-4 sm:ml-10' : '' %>" aria-label="<%= comment[:parent_id] ? 'Resposta' : 'Comentário' %>">
  <% if comment[:state] == "visible" %>
    <% author = comment[:author] %>
    <header class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
      <span class="grid size-7 place-items-center rounded-full bg-positive-soft text-xs font-bold text-brand-link" aria-hidden="true"><%= initials_for(author[:display_name]) %></span>
      <% if author[:public_profile] && author[:id] %>
        <%= link_to author[:display_name], person_path(author[:id]), class: "font-semibold !text-ink hover:underline" %>
        <% if author[:username] %><span class="text-muted">@<%= author[:username] %></span><% end %>
      <% else %>
        <span class="font-semibold text-ink"><%= author[:display_name] %></span>
      <% end %>
      <span class="text-xs text-muted">· <%= sgu_time(comment[:created_at]) %><%= " · editado" if comment[:edited] %></span>
    </header>
    <p class="sgu-prose mt-2 text-sm"><%= comment[:body] %></p>
    <footer class="mt-3 flex flex-wrap items-center gap-2">
      <% if permissions.like_comment?(comment) %>
        <%= button_to comment_like_path(comment[:id]), method: (comment[:viewer_liked] ? :delete : :post), class: "sgu-btn sgu-btn-sm sgu-btn-ghost sgu-btn-toggle",
              aria: { pressed: comment[:viewer_liked], label: "#{comment[:viewer_liked] ? 'Descurtir' : 'Curtir'} comentário (#{comment[:likes_count]})" } do %>
          <%= sgu_icon("heart", "size-3.5") %><span><%= comment[:likes_count] %></span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-1 text-xs text-muted"><%= sgu_icon("heart", "size-3.5") %> <%= comment[:likes_count] %></span>
      <% end %>
      <% if permissions.edit_comment?(comment) %>
        <%= link_to "Editar", edit_comment_path(comment[:id]), class: "sgu-btn sgu-btn-sm sgu-btn-ghost" %>
        <%= button_to "Apagar", comment_path(comment[:id]), method: :delete, class: "sgu-btn sgu-btn-sm sgu-btn-ghost !text-negative-ink",
              data: { turbo_confirm: "Apagar seu comentário? As respostas de outras pessoas continuam visíveis." } %>
      <% end %>
      <% if permissions.report_comment?(comment) %>
        <%= link_to new_comment_content_report_path(comment[:id]), class: "sgu-btn sgu-btn-sm sgu-btn-ghost", title: "Denunciar comentário" do %><%= sgu_icon("flag", "size-3.5") %><span class="sr-only sm:not-sr-only">Denunciar</span><% end %>
      <% end %>
    </footer>
  <% else %>
    <p class="text-sm italic text-muted">
      <%= comment[:state] == "removed" ? "Comentário removido pela moderação." : "Comentário apagado pelo autor." %>
    </p>
  <% end %>

  <% if permissions.reply_to?(comment) %>
    <details class="mt-3" id="<%= dom_id %>_reply">
      <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-sm font-semibold text-brand-link"><%= sgu_icon("reply", "size-3.5") %> Responder</summary>
      <%= render "comments/form", publication_id: publication_id, parent_id: comment[:id], body: nil, form_id: "#{dom_id}_reply_form" %>
    </details>
  <% end %>
</article>
