<% content_for :title, "Meu perfil - SGU UFRPE" %>
<div class="profile-page">
  <%= render "profiles/own_header", user: @user, posts_count: @posts_count, followers_count: @followers_count, following_count: @following_count %>
  <%= render "profiles/own_tabs", active: :posts %>

  <%= render "profiles/grid", cards: @grid_cards, pagy: @pagy,
        empty_title: "Ainda não há publicações",
        empty_text: "Quando você registrar uma ocorrência e ela for ao mural, ela aparece aqui." %>

  <details class="profile-private">
    <summary><%= sgu_icon("lock", "size-4") %> Dados da conta <span>(só você vê)</span></summary>
    <dl class="sgu-dl">
      <dt>E-mail da conta</dt><dd><%= @user.email_address %></dd>
      <dt>Papéis</dt><dd><%= @user.roles.active.ordered.map(&:name).to_sentence.presence || "Nenhum" %> <span class="text-xs text-muted">(definidos pela administração)</span></dd>
    </dl>
  </details>
</div>
