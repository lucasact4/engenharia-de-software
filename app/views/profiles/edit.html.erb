<% content_for :title, "Editar perfil - SGU UFRPE" %>
<div class="mx-auto max-w-3xl space-y-5">
  <%= link_to profile_path, class: "inline-flex items-center gap-1 text-sm font-semibold !text-muted hover:!text-brand-link" do %><%= sgu_icon("chevron-left") %> Meu perfil<% end %>
  <h1 class="sgu-page-title">Editar perfil</h1>
  <%= form_with model: @user, scope: :user, url: profile_path, method: :patch, class: "sgu-card space-y-4 p-5 sm:p-6", html: { novalidate: true } do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-xl border border-negative-line bg-negative-soft p-3 text-sm text-negative-ink" role="alert">Revise os campos destacados.</div>
    <% end %>
    <div>
      <%= f.label :avatar, "Foto de perfil", class: "sgu-label" %>
      <%= f.file_field :avatar, accept: "image/png,image/jpeg", class: "sgu-input" %>
      <p class="sgu-hint">PNG ou JPEG, até 5 MB. Visível aos outros quando seu perfil for público.</p>
      <%= field_errors(@user, :avatar) %>
    </div>
    <%= render "shared/profile_fields", f: f, user: @user %>
    <fieldset class="rounded-xl border border-line p-4">
      <legend class="px-1 font-bold">Notificações por e-mail</legend>
      <p class="mb-3 text-sm text-muted">Usaremos seu endereço cadastrado somente para avisos do SGU. Cada mensagem contém o protocolo e a situação, sem descrição do relato.</p>
      <label class="flex items-start gap-3 text-sm"><%= f.check_box :email_notifications_enabled, class: "mt-1 size-4 accent-brand-solid" %><span>Consinto em receber atualizações dos relatos que registrei ou acompanho e alertas públicos próximos ao local escolhido.</span></label>
      <div class="mt-4 space-y-3">
        <label class="flex items-start gap-3 text-sm"><%= f.check_box :nearby_alerts_email_enabled, class: "mt-1 size-4 accent-brand-solid" %><span>Receber alertas públicos próximos</span></label>
        <div><%= f.label :notification_location_id, "Local de referência", class: "sgu-label" %><%= f.select :notification_location_id, Location.active.ordered.map { |location| [location.name, location.id] }, { include_blank: "Selecione um local do campus" }, class: "sgu-input" %><p class="sgu-hint">O SGU usa somente o ponto do catálogo; sua localização pessoal não é coletada.</p></div>
        <div><%= f.label :nearby_alerts_radius_km, "Distância máxima (km)", class: "sgu-label" %><%= f.number_field :nearby_alerts_radius_km, min: 1, max: 25, step: 1, class: "sgu-input" %></div>
      </div>
      <p class="mt-3 text-xs text-muted">Você pode retirar o consentimento nesta página. A escolha não altera avisos necessários à segurança da conta.</p>
    </fieldset>
    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", profile_path, class: "sgu-btn sgu-btn-secondary" %>
      <%= f.button "Salvar perfil", type: "submit", class: "sgu-btn sgu-btn-primary" %>
    </div>
  <% end %>
</div>
