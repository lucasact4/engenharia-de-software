<% content_for :title, "Editar perfil - SGU UFRPE" %>
<div class="mx-auto max-w-3xl space-y-5">
  <%= back_link profile_path, "Meu perfil" %>
  <h1 class="sgu-page-title">Editar perfil</h1>
  <% if @user.email_confirmed_at? %>
    <p>E-mail confirmado.</p>
  <% else %>
    <%= button_to "Reenviar confirmação de e-mail", email_confirmation_path, class: "sgu-btn sgu-btn-secondary" %>
  <% end %>
  <% if @user.google_subject? || GoogleSignIn.configured? %>
    <section class="sgu-card space-y-3 p-5 sm:p-6">
      <h2 class="sgu-section-title"><%= t("authentication.google.profile_title") %></h2>
      <% if @user.google_subject? %>
        <p><%= t("authentication.google.connected") %></p>
        <%= button_to t("authentication.google.disconnect"), google_connection_path, method: :delete,
                      class: "sgu-btn sgu-btn-secondary" %>
      <% else %>
        <p><%= t("authentication.google.link_instructions") %></p>
        <%= form_with url: google_connection_path, class: "space-y-3", data: { turbo: false } do |form| %>
          <div>
            <%= form.label :password, t("authentication.google.current_password"), for: "google_current_password", class: "sgu-label" %>
            <%= form.password_field :password, id: "google_current_password", autocomplete: "current-password",
                                    required: true, maxlength: 72, class: "sgu-input" %>
          </div>
          <%= form.submit t("authentication.google.connect"), class: "sgu-btn sgu-btn-secondary" %>
        <% end %>
      <% end %>
    </section>
  <% end %>
  <%= form_with model: @user, scope: :user, url: profile_path, method: :patch, class: "sgu-card space-y-4 p-5 sm:p-6", html: { novalidate: true } do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-xl border border-negative-line bg-negative-soft p-3 text-sm text-negative-ink" role="alert">Revise os campos destacados.</div>
    <% end %>
    <div>
      <div class="profile-edit-photo">
        <%= account_avatar(@user, "profile-edit-avatar") %>
        <div>
          <strong><%= @user.username.presence || account_handle(@user) %></strong>
          <%= f.label :avatar, "Alterar foto", class: "profile-edit-photo-label" %>
        </div>
      </div>
      <%= f.label :avatar, "Foto de perfil", class: "sgu-label" %>
      <%= f.file_field :avatar, accept: "image/png,image/jpeg", class: "sgu-input" %>
      <p class="sgu-hint">PNG ou JPEG, até 5 MB. Visível aos outros quando seu perfil for público.</p>
      <%= field_errors(@user, :avatar) %>
    </div>
    <%= render "shared/profile_fields", f: f, user: @user %>
    <p><%= link_to "Preferências de notificações", notifications_path %></p>
    <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
      <%= link_to "Cancelar", profile_path, class: "sgu-btn sgu-btn-secondary" %>
      <%= f.button "Salvar perfil", type: "submit", class: "sgu-btn sgu-btn-primary" %>
    </div>
  <% end %>
</div>
