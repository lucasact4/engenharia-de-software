<%# Grade de publicações do perfil. Locais: cards, pagy, empty_title, empty_text, empty_icon (opcional) %>
<% if cards.any? %>
  <ul class="profile-grid" role="list">
    <% cards.each_with_index do |card, index| %>
      <% photo = card[:photos].first %>
      <li class="profile-grid-item" style="--tile-delay: <%= [index, 11].min * 45 %>ms">
        <%= link_to publication_path(card[:id]), class: "profile-tile" do %>
          <span class="sr-only"><%= card[:kind_label] %>: <%= card[:title] %>. <%= pluralize(card[:likes_count], "curtida") %>, <%= pluralize(card[:comments_count], "comentário") %>.</span>
          <% if photo %>
            <%= image_tag publication_media_path(publication_id: card[:id], id: photo[:id]), alt: "", class: "profile-tile-image", loading: "lazy", decoding: "async" %>
          <% else %>
            <span class="profile-tile-text profile-tile-text--<%= card[:kind] %>" aria-hidden="true">
              <small><%= card[:kind_label] %></small>
              <strong><%= truncate(card[:title].to_s, length: 90, separator: " ") %></strong>
            </span>
          <% end %>
          <% if card[:photos].size > 1 %>
            <span class="profile-tile-badge" title="<%= card[:photos].size %> fotos"><%= sgu_icon("copy", "size-5") %></span>
          <% elsif card[:visibility] == "internal" %>
            <span class="profile-tile-badge" title="Visível só para a comunidade UFRPE"><%= sgu_icon("lock", "size-4") %></span>
          <% end %>
          <span class="profile-tile-overlay" aria-hidden="true">
            <span><%= sgu_icon("heart", "size-5") %> <%= number_with_delimiter(card[:likes_count]) %></span>
            <span><%= sgu_icon("message-circle", "size-5") %> <%= number_with_delimiter(card[:comments_count]) %></span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", pagy: pagy %>
<% else %>
  <div class="profile-empty">
    <span class="profile-empty-icon"><%= sgu_icon(local_assigns[:empty_icon] || "camera", "size-9") %></span>
    <h2><%= empty_title %></h2>
    <p><%= empty_text %></p>
  </div>
<% end %>
