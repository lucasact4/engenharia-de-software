<% content_for :title, "Minhas denúncias - SGU UFRPE" %>
<p class="sgu-eyebrow">Privado</p>
<h1 class="sgu-page-title mt-1">Minhas denúncias</h1>
<p class="mt-2 text-muted">Só você e a administração veem esta lista.</p>
<% if @reports.any? %>
  <ul class="mt-5 space-y-3">
    <% @reports.each do |report| %>
      <li>
        <%= link_to content_report_path(report), class: "sgu-card flex items-center justify-between gap-3 p-4 !text-ink hover:border-brand-link" do %>
          <span>
            <span class="block text-xs text-muted"><%= report.comment_id ? "Comentário" : "Publicação" %> · <%= sgu_time(report.created_at) %></span>
            <span class="block font-semibold"><%= enum_label("content_report.reason", report.reason) %></span>
          </span>
          <%= enum_badge("content_report.state", report.state, PortalHelper::REPORT_STATE_BADGES) %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= render "shared/pagination", pagy: @pagy %>
<% else %>
  <div class="sgu-empty mt-5"><p class="text-sm text-muted">Você não fez denúncias.</p></div>
<% end %>
