<% identity = PublicIdentity.for(@person) %>
<% content_for :title, "Seguidores de #{identity[:display_name]} - SGU UFRPE" %>
<div class="mx-auto max-w-3xl space-y-4">
  <%= link_to person_path(@person), class: "inline-flex items-center gap-1 text-sm font-semibold !text-muted hover:!text-brand-link" do %><%= sgu_icon("chevron-left") %> <%= identity[:display_name] %><% end %>
  <h1 class="sgu-page-title">Seguidores</h1>
  <p class="text-sm text-muted"><%= pluralize(@followers_count, "seguidor", plural: "seguidores") %> no total. A lista mostra apenas quem também tem perfil público.</p>
  <% if @followers.any? %>
    <ul class="grid gap-3 sm:grid-cols-2"><%= render partial: "public_profiles/person_card", collection: @followers, as: :person %></ul>
    <%= render "shared/pagination", pagy: @pagy %>
  <% else %>
    <div class="sgu-empty"><p class="text-sm text-muted">Nenhum seguidor com perfil público.</p></div>
  <% end %>
</div>
